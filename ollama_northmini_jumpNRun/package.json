{
  "name": "ollama-northmini-jumpnrun",
  "version": "1.0.0",
  "description": "A 2D side-scrolling jump-and-run browser game inspired by classic platformers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:firefox": "vitest --browser firefox",
    "lint": "eslint src",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "ci": "npm run lint && npm run type-check && npm run test && npm run test:firefox && npm run build"
  },
  "dependencies": {
    "vite": "^6.4.3",
    "@vitejs/plugin-react": "^4.0.0",
    "@types/node": "^20.0.0"
  },
  "devDependencies": {
    "vite": "^6.4.3",
    "@vitejs/plugin-react": "^4.0.0",
    "vitest": "^3.2.7",
    "@testing-library/jest-dom": "^6.0.0",
    "jsdom": "^22.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "@types/offscreencanvas": "^2019.7.0"
  },
  "engines": {
    "node": "^18.0.0"
  }
}