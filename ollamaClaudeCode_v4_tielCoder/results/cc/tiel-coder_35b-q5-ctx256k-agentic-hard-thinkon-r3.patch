 def parse_amount(text):
@@ -14,4 +14,21 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1]
+    if s.startswith("-"):
+        negative = True
+        s = s[1:]
+    elif s.startswith("+"):
+        s = s[1:]
+    s = s.replace(",", "")
+    try:
+        value = Decimal(s)
+    except InvalidOperation:
+        raise ValueError(f"not a valid amount: {text!r}")
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.00"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..2e9b863 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,22 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped[0] == "#":
+        return None
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}: {line!r}")
+    day, category, amount, currency = parts
+    currency = currency.strip().upper()
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"invalid currency: {currency!r}")
+    return Entry(
+        date.fromisoformat(day.strip()),
+        category.strip().lower(),
+        parse_amount(amount),
+        currency,
+    )
 
 
