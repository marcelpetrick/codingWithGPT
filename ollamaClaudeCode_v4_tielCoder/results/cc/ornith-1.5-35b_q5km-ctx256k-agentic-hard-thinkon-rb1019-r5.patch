 def parse_amount(text):
@@ -14,4 +14,20 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    s = s.replace(",", "")
+    if not s:
+        raise ValueError(f"invalid amount: {text!r}")
+    try:
+        value = Decimal(s)
+    except InvalidOperation as exc:
+        raise ValueError(f"invalid amount: {text!r}") from None
+    if not value.is_finite():
+        raise ValueError(f"invalid amount: {text!r}")
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..fd23e9c 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,20 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}: {line!r}")
+    day, category, amount, currency = (part.strip() for part in parts)
+    entry_day = date.fromisoformat(day)
+    category = category.lower()
+    parsed_amount = parse_amount(amount)
+    currency = currency.upper()
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"currency must be three letters: {currency!r}")
+    return Entry(entry_day, category, parsed_amount, currency)
 
 
