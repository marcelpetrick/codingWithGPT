 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, ROUND_HALF_UP
 
 
 def parse_amount(text):
@@ -14,4 +14,23 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+
+    # Remove thousands separators (commas)
+    text = text.replace(",", "")
+
+    try:
+        value = Decimal(text)
+    except Exception:
+        raise ValueError(f"Cannot parse amount: {text!r}")
+
+    if negative:
+        value = -value
+
+    # Round/quantize to exactly two decimal places
+    return value.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
