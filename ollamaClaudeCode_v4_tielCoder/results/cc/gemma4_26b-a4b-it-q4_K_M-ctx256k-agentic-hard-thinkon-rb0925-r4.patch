--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,19 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    if not text:
+        raise ValueError("Empty amount")
+
+    # Handle parentheses for negative numbers
+    if text.startswith('(') and text.endswith(')'):
+        text = '-' + text[1:-1]
+
+    # Remove thousands separators
+    text = text.replace(',', '')
+
+    try:
+        amount = Decimal(text).quantize(Decimal("0.00"))
+        return amount
+    except Exception as e:
+        raise ValueError(f"Invalid amount: {text}") from e
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..853847d 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,28 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith('#'):
+        return None
+
+    parts = [p.strip() for p in line.split(";")]
+    if len(parts) != 4:
+        raise ValueError(f"Expected 4 fields, got {len(parts)}")
+
+    day_str, category, amount_str, currency = parts
+
+    # DATE is ISO 8601, YYYY-MM-DD
+    day = date.fromisoformat(day_str)
+    # CATEGORY is stripped and lower-cased
+    category = category.lower()
+    # AMOUNT is parsed with parse_amount
+    amount = parse_amount(amount_str)
+    # CURRENCY is stripped and upper-cased, and must be exactly three letters
+    currency = currency.upper()
+    if len(currency) != 3:
+        raise ValueError(f"Invalid currency: {currency}")
+
+    return Entry(day, category, amount, currency)
 
 
