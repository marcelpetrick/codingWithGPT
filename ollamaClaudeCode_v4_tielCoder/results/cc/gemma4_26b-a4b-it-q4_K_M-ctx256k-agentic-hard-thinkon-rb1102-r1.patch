@@ -14,4 +13,21 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    if not text:
+        raise ValueError("Empty amount")
+
+    # Handle accounting negatives
+    if text.startswith('(') and text.endswith(')'):
+        text = '-' + text[1:-1]
+
+    # Remove thousands separators
+    text = text.replace(',', '')
+
+    try:
+        amount = Decimal(text)
+        # Ensure two decimal places
+        amount = amount.quantize(Decimal("0.00"))
+        return amount
+    except (InvalidOperation, ValueError) as e:
+        raise ValueError(f"Invalid amount: {text}") from e
