--- a/ledger/money.py
+++ b/ledger/money.py
@@ -1,6 +1,9 @@
 """Money parsing."""
+import re
 from decimal import Decimal
 
+_AMOUNT_RE = re.compile(r"^[0-9]+(?:\.[0-9]+)?$")
+
 
 def parse_amount(text):
     """Parse a ledger amount into a Decimal.
@@ -14,4 +17,19 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    if s[:1] in "+-":
+        if s[0] == "-":
+            negative = not negative
+        s = s[1:].strip()
+    s = s.replace(",", "")
+    if not _AMOUNT_RE.match(s):
+        raise ValueError(f"invalid amount: {text!r}")
+    value = Decimal(s)
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..e0980cc 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,25 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped[0] == "#":
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}: {line!r}")
+
+    day, category, amount, currency = (p.strip() for p in parts)
+
+    if not currency.isalpha() or len(currency) != 3:
+        raise ValueError(f"currency must be three letters: {currency!r}")
+
+    return Entry(
+        date.fromisoformat(day),
+        category.lower(),
+        parse_amount(amount),
+        currency.upper(),
+    )
 
 
