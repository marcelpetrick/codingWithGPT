 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    connect(model, &IssueModel::rowsInserted, this, &BacklogSummary::update);
+    connect(model, &IssueModel::rowsRemoved, this, &BacklogSummary::update);
+    connect(model, &IssueModel::modelReset, this, &BacklogSummary::update);
+    connect(model, &IssueModel::dataChanged, this, &BacklogSummary::update);
+    connect(model, &IssueModel::destroyed, this, [this]() {
+        m_model = nullptr;
+        m_openMinutes = 0;
+    });
+    update();
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
+}
+
+void BacklogSummary::update()
+{
+    if (!m_model) {
+        if (m_openMinutes != 0) {
+            m_openMinutes = 0;
+            emit totalChanged(0);
+        }
+        return;
+    }
+    int total = 0;
+    for (int i = 0; i < m_model->rowCount(); ++i) {
+        QModelIndex idx = m_model->index(i, 0);
+        bool closed = m_model->data(idx, IssueModel::ClosedRole).toBool();
+        int estimate = m_model->data(idx, IssueModel::EstimateRole).toInt();
+        if (!closed)
+            total += estimate;
+    }
+    if (total != m_openMinutes) {
+        m_openMinutes = total;
+        emit totalChanged(total);
+    }
 }
