diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..f6e34ca 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -1,5 +1,5 @@
 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,22 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    # Remove whitespace
+    text = text.strip()
+
+    # Handle parentheses as negatives
+    if text.startswith("(") and text.endswith(")"):
+        text = "-" + text[1:-1]
+
+    # Remove thousands separators (commas)
+    if "," in text:
+        text = text.replace(",", "")
+
+    try:
+        result = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"Invalid amount: {text}")
+
+    # Ensure exactly two decimal places
+    result = result.quantize(Decimal("0.01"))
+    return result
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..5b66e4d 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,7 +26,16 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
+    # Handle comments and blank lines
+    if not line.strip():
+        return None
+    if line.lstrip().startswith("#"):
+        return None
+
     day, category, amount, currency = line.split(";")
+    # Normalize category and currency as specified
+    category = category.strip().lower()
+    currency = currency.strip().upper()
     return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
 
 
