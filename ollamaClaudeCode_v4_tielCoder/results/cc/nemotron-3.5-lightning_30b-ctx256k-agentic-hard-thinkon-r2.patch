     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+
+    # Blank lines return None
+    if not stripped:
+        return None
+
+    # Comment lines return None
+    if stripped.startswith("#"):
+        return None
+
+    day, category, amount, currency = stripped.split(";")
+    return Entry(
+        day=date.fromisoformat(day),
+        category=category.strip().lower(),
+        amount=parse_amount(amount),
+        currency=currency.strip().upper(),
+    )
 
 
