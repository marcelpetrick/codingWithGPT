diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..21ce1b0 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,20 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    # Accounting negatives in parentheses: "(12.50)" means -12.50
+    if text.startswith("(") and text.endswith(")"):
+        text = "-" + text[1:-1]
+        text = text.strip()
+
+    # Remove thousands separators (commas)
+    text = text.replace(",", "")
+
+    try:
+        result = Decimal(text)
+    except Exception:
+        raise ValueError(f"Cannot parse amount: {text!r}")
+
+    # Always return exactly two decimal places
+    return result.quantize(Decimal("0.01"))
