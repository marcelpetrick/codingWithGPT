diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..4b7ce8d 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,23 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    # Handle accounting negatives in parentheses: (12.50) means -12.50
+    if text.startswith('(') and text.endswith(')'):
+        text = '-' + text[1:-1]
+
+    # Remove thousands separators (commas)
+    text = text.replace(',', '')
+
+    # Validate that the text is a valid number
+    try:
+        result = Decimal(text)
+    except Exception as e:
+        raise ValueError(f"Invalid amount: {text}") from e
+
+    # Ensure exactly two decimal places
+    # Using quantize to force two decimal places
+    result = result.quantize(Decimal('0.00'))
+
+    return result
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..8d40eff 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,29 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    line = line.strip()
+
+    # Handle blank lines and comments
+    if not line or line.startswith('#'):
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"Expected 4 fields, got {len(parts)}")
+
+    day_str, category, amount, currency = parts
+
+    # Strip and process fields
+    day_str = day_str.strip()
+    category = category.strip().lower()
+    amount = amount.strip()
+    currency = currency.strip().upper()
+
+    # Validate currency is exactly 3 letters
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"Currency must be exactly 3 letters: {currency}")
+
+    return Entry(date.fromisoformat(day_str), category, parse_amount(amount), currency)
 
 
