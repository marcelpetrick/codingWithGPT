 """Parse ledger text into entries."""
+import re
 from dataclasses import dataclass
 from datetime import date
 from decimal import Decimal
@@ -26,8 +27,32 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"malformed line (expected 4 fields): {line!r}")
+
+    day_str, category, amount_str, currency = parts
+
+    try:
+        day = date.fromisoformat(day_str.strip())
+    except ValueError:
+        raise ValueError(f"invalid date: {day_str!r}")
+
+    category = category.strip().lower()
+    if not category:
+        raise ValueError("empty category")
+
+    amount = parse_amount(amount_str)
+
+    currency = currency.strip().upper()
+    if not re.fullmatch(r"[A-Za-z]{3}", currency):
+        raise ValueError(f"invalid currency (must be 3 letters): {currency!r}")
+
+    return Entry(day, category, amount, currency)
 
 
