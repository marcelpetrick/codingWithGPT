 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
 
 
 def parse_amount(text):
@@ -14,4 +14,35 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    raw = text.strip()
+    if not raw:
+        raise ValueError(f"empty amount: {text!r}")
+
+    negative = False
+    # Accounting notation: (12.50) => -12.50
+    if raw.startswith("(") and raw.endswith(")"):
+        negative = True
+        raw = raw[1:-1].strip()
+
+    # Signed decimal prefix
+    sign = 1
+    if raw.startswith("+"):
+        raw = raw[1:]
+    elif raw.startswith("-"):
+        sign = -1
+        raw = raw[1:]
+
+    if negative:
+        sign = -sign
+
+    # Remove thousands separators (commas).
+    cleaned = raw.replace(",", "")
+
+    try:
+        value = Decimal(cleaned)
+    except InvalidOperation:
+        raise ValueError(f"invalid amount: {text!r}")
+
+    value = value * sign
+    # Always two decimal places, half-up rounding.
+    return value.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
