diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..68a1752 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,26 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    # Handle parentheses for negative numbers (accounting format)
+    negative = False
+    if text.startswith('(') and text.endswith(')'):
+        negative = True
+        text = text[1:-1]
+
+    # Remove thousands separators (commas)
+    text = text.replace(',', '')
+
+    try:
+        amount = Decimal(text)
+    except Exception:
+        raise ValueError(f"Invalid amount: {text}")
+
+    if negative:
+        amount = -amount
+
+    # Ensure exactly two decimal places
+    amount = amount.quantize(Decimal('0.00'))
+
+    return amount
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..8b0c60f 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,7 +26,30 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
+    # Check for blank lines
+    stripped = line.strip()
+    if not stripped:
+        return None
+
+    # Check for comment lines
+    if stripped.startswith('#'):
+        return None
+
+    # Split and strip fields
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError("Expected 4 fields")
+
+    day, category, amount, currency = parts
+    day = day.strip()
+    category = category.strip().lower()
+    amount = amount.strip()
+    currency = currency.strip().upper()
+
+    # Validate currency is exactly three letters
+    if len(currency) != 3:
+        raise ValueError("Currency must be exactly three letters")
+
     return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
 
 
