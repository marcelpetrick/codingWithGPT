 """Money parsing."""
+import re
 from decimal import Decimal
 
+_TWO_PLACES = Decimal("0.01")
+
+# Digits with an optional fractional part, e.g. "7", "12.50".
+_PLAIN = re.compile(r"^\d+(?:\.\d+)?$")
+# Same, but with thousands separators in groups of three, e.g. "1,234.50".
+_GROUPS = re.compile(r"^\d{1,3}(?:,\d{3})*(?:\.\d+)?$")
+
 
 def parse_amount(text):
     """Parse a ledger amount into a Decimal.
@@ -14,4 +22,20 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    if not isinstance(text, str):
+        raise ValueError(f"amount must be a string, got {type(text).__name__}")
+    stripped = text.strip()
+    in_parens = stripped.startswith("(") and stripped.endswith(")")
+    if in_parens:
+        stripped = stripped[1:-1].strip()
+    sign = 1
+    if stripped.startswith(("+", "-")):
+        if in_parens:
+            raise ValueError(f"malformed amount: {text!r}")
+        sign = -1 if stripped.startswith("-") else 1
+        stripped = stripped[1:]
+    elif in_parens:
+        sign = -1
+    if not (_PLAIN.match(stripped) or _GROUPS.match(stripped)):
+        raise ValueError(f"malformed amount: {text!r}")
+    return (sign * Decimal(stripped.replace(",", ""))).quantize(_TWO_PLACES)
