--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,22 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields separated by ';', got {len(parts)}")
+    day_s, category, amount_s, currency = (p.strip() for p in parts)
+    try:
+        day = date.fromisoformat(day_s)
+    except ValueError:
+        raise ValueError(f"invalid date: {day_s!r}")
+    category = category.lower()
+    currency = currency.upper()
+    if not (len(currency) == 3 and currency.isalpha()):
+        raise ValueError(f"currency must be exactly three letters: {currency!r}")
+    return Entry(day, category, parse_amount(amount_s), currency)
 
 
