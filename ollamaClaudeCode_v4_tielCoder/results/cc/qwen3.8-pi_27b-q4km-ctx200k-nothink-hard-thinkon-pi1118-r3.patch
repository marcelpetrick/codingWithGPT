 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+
+TWO_PLACES = Decimal("0.01")
 
 
 def parse_amount(text):
@@ -14,4 +16,33 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    if not isinstance(text, str):
+        raise ValueError(f"amount must be a string, got {type(text).__name__}")
+    s = text.strip()
+    negative = False
+    if len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        negative = True
+        s = s[1:-1].strip()
+    if "," in s:
+        groups = s.split(",")
+        if "." in groups[0]:
+            raise ValueError(f"invalid amount: {text!r}")
+        if len(groups) < 2 or not (1 <= len(groups[0]) <= 3):
+            raise ValueError(f"invalid amount: {text!r}")
+        for g in groups[1:]:
+            if "." in g:
+                int_part, _, _ = g.partition(".")
+                if len(int_part) != 3:
+                    raise ValueError(f"invalid amount: {text!r}")
+            elif len(g) != 3:
+                raise ValueError(f"invalid amount: {text!r}")
+        s = s.replace(",", "")
+    try:
+        value = Decimal(s)
+    except InvalidOperation:
+        raise ValueError(f"invalid amount: {text!r}")
+    if not value.is_finite():
+        raise ValueError(f"invalid amount: {text!r}")
+    if negative:
+        value = -value
+    return value.quantize(TWO_PLACES, rounding=ROUND_HALF_UP)
