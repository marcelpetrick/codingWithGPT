diff --git a/src/backlogsummary.cpp b/src/backlogsummary.cpp
index 257e0df..68c775e 100644
--- a/src/backlogsummary.cpp
+++ b/src/backlogsummary.cpp
@@ -1,8 +1,80 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+class BacklogSummaryPrivate
+{
+public:
+    IssueModel *model = nullptr;
+    int openMinutes = 0;
+
+    void recalculate(IssueModel *m)
+    {
+        int total = 0;
+        if (m) {
+            for (int row = 0; row < m->rowCount(); ++row) {
+                const QModelIndex idx = m->index(row, 0);
+                const bool closed = m->data(idx, IssueModel::ClosedRole).toBool();
+                const int estimate = m->data(idx, IssueModel::EstimateRole).toInt();
+                if (!closed)
+                    total += estimate;
+            }
+        }
+        if (total != openMinutes) {
+            openMinutes = total;
+        }
+    }
+};
+
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent)
+    , d(new BacklogSummaryPrivate())
+{
+    d->model = model;
+    d->recalculate(model);
+
+    if (model) {
+        connect(model, &QAbstractItemModel::rowsInserted, this, [this]() {
+            d->recalculate(d->model);
+            if (d->openMinutes != 0)
+                emit totalChanged(d->openMinutes);
+        });
+        connect(model, &QAbstractItemModel::rowsRemoved, this, [this]() {
+            d->recalculate(d->model);
+            if (d->openMinutes != 0)
+                emit totalChanged(d->openMinutes);
+        });
+        connect(model, &QAbstractItemModel::modelReset, this, [this]() {
+            d->recalculate(d->model);
+            if (d->openMinutes != 0)
+                emit totalChanged(d->openMinutes);
+        });
+        connect(model, &QAbstractItemModel::dataChanged, this, [this](const QModelIndex &, const QModelIndex &, const QVector<int> &roles) {
+            for (int role : roles) {
+                if (role == IssueModel::EstimateRole || role == IssueModel::ClosedRole) {
+                    d->recalculate(d->model);
+                    if (d->openMinutes != 0)
+                        emit totalChanged(d->openMinutes);
+                    return;
+                }
+            }
+        });
+        connect(model, &QObject::destroyed, this, [this]() {
+            d->model = nullptr;
+            d->recalculate(nullptr);
+            if (d->openMinutes != 0)
+                emit totalChanged(d->openMinutes);
+        });
+    }
+}
+
+BacklogSummary::~BacklogSummary()
+{
+    delete d;
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    if (!d->model)
+        return 0;
+    return d->openMinutes;
 }
