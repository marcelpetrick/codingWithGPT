 def parse_amount(text):
@@ -14,4 +14,20 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    if not text:
+        raise ValueError("Empty amount")
+
+    # Handle accounting negatives: (12.50) -> -12.50
+    if text.startswith("(") and text.endswith(")"):
+        text = "-" + text[1:-1]
+
+    # Handle thousands separators: 1,234.50 -> 1234.50
+    text = text.replace(",", "")
+
+    try:
+        amount = Decimal(text)
+        # Ensure exactly two decimal places
+        return amount.quantize(Decimal("0.00"))
+    except (InvalidOperation, ValueError) as e:
+        raise ValueError(f"Invalid amount: {text}") from e
