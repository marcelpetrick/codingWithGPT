@@ -1,6 +1,22 @@
 """Money parsing."""
+import re
 from decimal import Decimal
 
+_AMOUNT_RE = re.compile(
+    r"""
+    ^\s*
+    (?P<sign>[+-]?)
+    \s*
+    (?:
+        (?:\((?P<paren>\d[\d,]*(?:\.\d+)?)\))  # accounting-negative form
+        |
+        (?P<num>\d[\d,]*(?:\.\d+)?)            # plain / signed form
+    )
+    \s*$
+    """,
+    re.VERBOSE,
+)
+
 
 def parse_amount(text):
     """Parse a ledger amount into a Decimal.
@@ -14,4 +30,11 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    match = _AMOUNT_RE.match(text)
+    if match is None:
+        raise ValueError(f"invalid amount: {text!r}")
+    digits = match.group("paren") or match.group("num")
+    value = Decimal(digits.replace(",", ""))
+    if match.group("sign") == "-" or match.group("paren") is not None:
+        value = -value
+    return value.quantize(Decimal("0.01"))
