@@ -1,8 +1,87 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    if (m_model) {
+        connect(m_model, &QAbstractItemModel::rowsInserted,
+                this, &BacklogSummary::onRowsInserted);
+        connect(m_model, &QAbstractItemModel::rowsRemoved,
+                this, &BacklogSummary::onRowsRemoved);
+        connect(m_model, &QAbstractItemModel::modelReset,
+                this, &BacklogSummary::onModelReset);
+        connect(m_model, &QAbstractItemModel::layoutChanged,
+                this, &BacklogSummary::recompute);
+        connect(m_model, &QObject::destroyed,
+                this, &BacklogSummary::onModelDestroyed);
+        recompute();
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_model ? m_openMinutes : 0;
+}
+
+void BacklogSummary::onRowsInserted(const QModelIndex &, int first, int last)
+{
+    if (!m_model)
+        return;
+    for (int row = first; row <= last; ++row) {
+        const int minutes = m_model->data(m_model->index(row, 0),
+                                          IssueModel::EstimateRole).toInt();
+        const bool closed = m_model->data(m_model->index(row, 0),
+                                          IssueModel::ClosedRole).toBool();
+        if (!closed)
+            m_openMinutes += minutes;
+    }
+    emit totalChanged(m_openMinutes);
+}
+
+void BacklogSummary::onRowsRemoved(const QModelIndex &, int first, int last)
+{
+    if (!m_model)
+        return;
+    for (int row = first; row <= last; ++row) {
+        const int minutes = m_model->data(m_model->index(row, 0),
+                                          IssueModel::EstimateRole).toInt();
+        const bool closed = m_model->data(m_model->index(row, 0),
+                                          IssueModel::ClosedRole).toBool();
+        if (!closed)
+            m_openMinutes -= minutes;
+    }
+    emit totalChanged(m_openMinutes);
+}
+
+void BacklogSummary::onModelReset()
+{
+    recompute();
+}
+
+void BacklogSummary::onModelDestroyed()
+{
+    m_model = nullptr;
+    if (m_openMinutes != 0) {
+        m_openMinutes = 0;
+        emit totalChanged(0);
+    }
+}
+
+void BacklogSummary::recompute()
+{
+    if (!m_model)
+        return;
+    int total = 0;
+    const int count = m_model->rowCount();
+    for (int row = 0; row < count; ++row) {
+        const QModelIndex index = m_model->index(row, 0);
+        const bool closed = m_model->data(index, IssueModel::ClosedRole).toBool();
+        if (!closed)
+            total += m_model->data(index, IssueModel::EstimateRole).toInt();
+    }
+    if (total == m_openMinutes)
+        return;
+    m_openMinutes = total;
+    emit totalChanged(total);
 }
