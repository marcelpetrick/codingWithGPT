+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields separated by ';', got {len(parts)}")
+    day_str, category, amount_str, currency = parts
+    return Entry(
+        date.fromisoformat(day_str.strip()),
+        category.strip().lower(),
+        parse_amount(amount_str),
+        currency.strip().upper(),
