diff --git a/src/backlogsummary.cpp b/src/backlogsummary.cpp
index 257e0df..469315c 100644
--- a/src/backlogsummary.cpp
+++ b/src/backlogsummary.cpp
@@ -1,8 +1,78 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+#include <QObject>
+
+class BacklogSummaryPrivate
+{
+public:
+    IssueModel *model = nullptr;
+    int minutes = 0;
+
+    void recalculate()
+    {
+        if (!model) {
+            minutes = 0;
+            return;
+        }
+        int total = 0;
+        for (int i = 0; i < model->rowCount(); ++i) {
+            const auto idx = model->index(i, 0);
+            const bool closed = model->data(idx, IssueModel::ClosedRole).toBool();
+            const int estimate = model->data(idx, IssueModel::EstimateRole).toInt();
+            if (!closed)
+                total += estimate;
+        }
+        minutes = total;
+    }
+};
+
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent)
+    , d_ptr(new BacklogSummaryPrivate())
+{
+    d_ptr->model = model;
+    d_ptr->recalculate();
+
+    if (model) {
+        connect(model, &QAbstractItemModel::rowsInserted, this, [this](const QModelIndex &, int, int) {
+            const int old = d_ptr->minutes;
+            d_ptr->recalculate();
+            if (d_ptr->minutes != old)
+                emit totalChanged(d_ptr->minutes);
+        });
+        connect(model, &QAbstractItemModel::rowsRemoved, this, [this](const QModelIndex &, int, int) {
+            const int old = d_ptr->minutes;
+            d_ptr->recalculate();
+            if (d_ptr->minutes != old)
+                emit totalChanged(d_ptr->minutes);
+        });
+        connect(model, &QAbstractItemModel::modelReset, this, [this]() {
+            d_ptr->recalculate();
+            emit totalChanged(d_ptr->minutes);
+        });
+        connect(model, &QAbstractItemModel::dataChanged, this, [this](const QModelIndex &, const QModelIndex &, const QList<int> &roles) {
+            if (roles.contains(IssueModel::EstimateRole) || roles.contains(IssueModel::ClosedRole)) {
+                const int old = d_ptr->minutes;
+                d_ptr->recalculate();
+                if (d_ptr->minutes != old)
+                    emit totalChanged(d_ptr->minutes);
+            }
+        });
+        connect(model, &QObject::destroyed, this, [this]() {
+            d_ptr->model = nullptr;
+            d_ptr->minutes = 0;
+            emit totalChanged(0);
+        });
+    }
+}
+
+BacklogSummary::~BacklogSummary()
+{
+    delete d_ptr;
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return d_ptr->minutes;
 }
