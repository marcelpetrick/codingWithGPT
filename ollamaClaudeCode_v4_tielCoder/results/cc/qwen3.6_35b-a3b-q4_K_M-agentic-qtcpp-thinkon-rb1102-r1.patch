@@ -1,8 +1,45 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+void BacklogSummary::computeTotal()
+{
+    int total = 0;
+    if (!m_model)
+        return;
+    for (int i = 0; i < m_model->rowCount(); ++i) {
+        const auto idx = m_model->index(i);
+        const bool closed = idx.data(IssueModel::ClosedRole).toBool();
+        const int estimate = idx.data(IssueModel::EstimateRole).toInt();
+        if (!closed)
+            total += estimate;
+    }
+    if (total != m_total) {
+        m_total = total;
+        emit totalChanged(m_total);
+    }
+}
+
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model), m_total(0)
+{
+    if (m_model) {
+        connect(m_model, &QAbstractItemModel::rowsInserted, this, [this](const QModelIndex &, int first, int last) {
+            (void)first; (void)last;
+            computeTotal();
+        });
+        connect(m_model, &QAbstractItemModel::rowsRemoved, this, [this](const QModelIndex &, int first, int last) {
+            (void)first; (void)last;
+            computeTotal();
+        });
+        connect(m_model, &QAbstractItemModel::modelReset, this, [this]() { computeTotal(); });
+        connect(m_model, &QAbstractItemModel::dataChanged, this, [this](const QModelIndex &, const QModelIndex &, const QVector<int> &) {
+            computeTotal();
+        });
+    }
+    computeTotal();
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_total;
 }
