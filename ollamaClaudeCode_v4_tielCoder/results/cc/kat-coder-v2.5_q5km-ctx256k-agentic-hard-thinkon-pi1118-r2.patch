diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..833e3fa 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,18 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+    text = text.replace(",", "")
+    try:
+        result = Decimal(text)
+    except Exception as exc:
+        raise ValueError(f"invalid amount: {text}") from exc
+    if negative:
+        result = -result
+    # Ensure exactly two decimal places
+    result = result.quantize(Decimal("0.00"))
+    return result
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..c9561ed 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,21 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields separated by semicolons, got {len(parts)}")
+    day, category, amount, currency = (p.strip() for p in parts)
+    if len(currency) != 3:
+        raise ValueError(f"currency must be exactly 3 letters, got '{currency}'")
+    return Entry(
+        date.fromisoformat(day),
+        category.lower(),
+        parse_amount(amount),
+        currency.upper(),
+    )
 
 
