+            total += value * 8 * 60;      // 8 hours * 60 minutes
         else if (unit == 'h')
             total += value * 60;
         else if (unit == 'm')
             total += value;
+        else
+            return -1;  // unknown unit
     }
     return total;
 }
 
 QString formatEstimate(int minutes)
 {
+    if (minutes < 0)
+        return QString();
+
+    if (minutes == 0)
+        return "0m";
+
     QStringList out;
+    const int totalMinutes = minutes;
+
+    // Weeks: 1w = 5d = 5*8*60 = 2400 minutes
+    const int weeks = totalMinutes / (5 * 8 * 60);
+    if (weeks > 0) {
+        out << QString::number(weeks) + "w";
+        minutes -= weeks * 5 * 8 * 60;
+    }
+
+    // Days: 1d = 8*60 = 480 minutes
+    const int days = minutes / (8 * 60);
+    if (days > 0) {
+        out << QString::number(days) + "d";
+        minutes -= days * 8 * 60;
+    }
+
+    // Hours: 1h = 60 minutes
     const int hours = minutes / 60;
-    if (hours)
+    if (hours > 0) {
         out << QString::number(hours) + "h";
-    out << QString::number(minutes % 60) + "m";
+        minutes -= hours * 60;
+    }
+
+    // Minutes
+    if (minutes > 0 || out.isEmpty()) {
+        out << QString::number(minutes) + "m";
+    }
+
     return out.join(' ');
 }
