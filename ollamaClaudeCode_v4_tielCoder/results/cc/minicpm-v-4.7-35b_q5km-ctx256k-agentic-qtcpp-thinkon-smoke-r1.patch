 int parseEstimate(const QString &text)
 {
+    if (text.trimmed().isEmpty())
+        return -1;
+
     int total = 0;
-    const QStringList parts = text.split(' ');
+    const QStringList parts = text.split(' ', Qt::SkipEmptyParts);
