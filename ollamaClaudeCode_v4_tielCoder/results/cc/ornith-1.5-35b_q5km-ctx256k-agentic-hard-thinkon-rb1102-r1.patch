 def parse_amount(text):
@@ -14,4 +14,33 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    body = text.strip()
+    negative = False
+
+    # Accounting negatives in parentheses: "(12.50)" -> -12.50.
+    if body.startswith("(") and body.endswith(")"):
+        negative = True
+        body = body[1:-1].strip()
+
+    # Leading sign on the magnitude itself.
+    if body.startswith("+"):
+        body = body[1:]
+    elif body.startswith("-"):
+        negative = not negative
+        body = body[1:]
+
+    # Thousands separators are purely cosmetic.
+    body = body.replace(",", "")
+
+    if not body:
+        raise ValueError(f"not a valid amount: {text!r}")
+
+    try:
+        value = Decimal(body)
+    except InvalidOperation as exc:
+        raise ValueError(f"not a valid amount: {text!r}") from exc
+
+    if negative:
+        value = -value
+
+    return value.quantize(Decimal("0.00"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..cdbc810 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,25 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+
+    fields = line.split(";")
+    if len(fields) != 4:
+        raise ValueError(f"expected DATE;CATEGORY;AMOUNT;CURRENCY, got {line!r}")
+
+    day, category, amount, currency = (field.strip() for field in fields)
+
+    if not (len(currency) == 3 and currency.isalpha()):
+        raise ValueError(f"currency must be three letters, got {currency!r}")
+
+    return Entry(
+        date.fromisoformat(day),
+        category.lower(),
+        parse_amount(amount),
+        currency.upper(),
+    )
 
 
