@@ -1,8 +1,52 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+#include <QAbstractItemModel>
+
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model), m_minutes(0)
+{
+    if (model) {
+        recalculate();
+        connect(model, &QAbstractItemModel::rowsInserted, this,
+                [this]() { recalculate(); });
+        connect(model, &QAbstractItemModel::rowsRemoved, this,
+                [this]() { recalculate(); });
+        connect(model, &QAbstractItemModel::modelReset, this,
+                [this]() { recalculate(); });
+        connect(model, &QAbstractItemModel::dataChanged, this,
+                [this](const QModelIndex &, const QModelIndex &, const QVector<int> &) {
+                    recalculate();
+                });
+        connect(model, &QObject::destroyed, this, [this]() {
+            m_minutes = 0;
+            emit totalChanged(0);
+        });
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    if (!m_model)
+        return 0;
+    return m_minutes;
+}
+
+void BacklogSummary::recalculate()
+{
+    if (!m_model)
+        return;
+    int total = 0;
+    const int rows = m_model->rowCount();
+    for (int i = 0; i < rows; ++i) {
+        const QModelIndex idx = m_model->index(i, 0);
+        const bool closed = m_model->data(idx, IssueModel::ClosedRole).toBool();
+        const int estimate = m_model->data(idx, IssueModel::EstimateRole).toInt();
+        if (!closed)
+            total += estimate;
+    }
+    if (total != m_minutes) {
+        m_minutes = total;
+        emit totalChanged(total);
+    }
 }
