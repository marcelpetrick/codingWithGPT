diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..5c17302 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,28 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    if not text:
+        raise ValueError("empty amount")
+
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1].strip()
+
+    sign = ""
+    if text.startswith(("+", "-")):
+        sign, text = text[0], text[1:].strip()
+        if text.startswith("(") and text.endswith(")"):
+            negative = True
+            text = text[1:-1].strip()
+
+    text = text.replace(",", "")
+    if not text or ("." in text and text.count(".") != 1):
+        raise ValueError(f"invalid amount: {text!r}")
+    integer_part, _, fractional_part = text.partition(".")
+    if not integer_part.isdigit() or (fractional_part and not fractional_part.isdigit()):
+        raise ValueError(f"invalid amount: {text!r}")
+
+    value = Decimal(sign + text).quantize(Decimal("0.00"))
+    return -value if negative else value
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..bb6e718 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,24 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped[0] == "#":
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}: {line!r}")
+    day, category, amount, currency = (p.strip() for p in parts)
+
+    if not currency.isalpha() or len(currency) != 3:
+        raise ValueError(f"currency must be three letters: {currency!r}")
+
+    return Entry(
+        date.fromisoformat(day),
+        category.lower(),
+        parse_amount(amount),
+        currency.upper(),
+    )
 
 
