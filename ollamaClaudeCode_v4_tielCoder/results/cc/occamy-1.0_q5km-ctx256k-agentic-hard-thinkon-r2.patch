@@ -1,6 +1,17 @@
 """Money parsing."""
+import re
 from decimal import Decimal
 
+# Matches: optional sign, then either (a) plain digits or (b) a leading group
+# of 1-3 digits followed by one or more exactly-3-digit comma groups, then an
+# optional fractional part ".ddd".
+_AMOUNT_RE = re.compile(
+    r'^[+-]?'
+    r'(\d{1,3}(?:,\d{3})+|\d+)'
+    r'(?:\.\d+)?'
+    r'$'
+)
+
 
 def parse_amount(text):
     """Parse a ledger amount into a Decimal.
@@ -14,4 +25,16 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    if not text:
+        raise ValueError(f"empty amount")
+    negated = False
+    if text[0] == '(' and text[-1] == ')':
+        negated = True
+        text = text[1:-1].strip()
+    if not _AMOUNT_RE.match(text):
+        raise ValueError(f"invalid amount: {text!r}")
+    value = Decimal(text.replace(',', ''))
+    if negated:
+        value = -value
+    return value.quantize(Decimal('0.00'))
