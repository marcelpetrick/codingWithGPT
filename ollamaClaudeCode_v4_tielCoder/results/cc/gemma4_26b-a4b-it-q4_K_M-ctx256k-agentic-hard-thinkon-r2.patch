-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.lstrip()
+    if not stripped or stripped.startswith('#'):
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"Expected 4 fields, got {len(parts)}")
+
+    day_str = parts[0].strip()
+    category = parts[1].strip().lower()
+    amount_str = parts[2].strip()
+    currency = parts[3].strip().upper()
+
+    if len(currency) != 3:
+        raise ValueError(f"Invalid currency: {currency!r}")
+
+    return Entry(date.fromisoformat(day_str), category, parse_amount(amount_str), currency)
 
 
