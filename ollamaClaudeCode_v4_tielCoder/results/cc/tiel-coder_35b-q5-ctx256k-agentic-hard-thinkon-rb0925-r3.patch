 """Money parsing."""
+import re
 from decimal import Decimal
 
+# Integer part: either grouped thousands ("1,234") or a plain run of digits.
+# Optional fractional part with at least one digit.
+_NUMBER_RE = re.compile(r"^[+-]?(\d{1,3}(?:,\d{3})*|\d+)(?:\.\d+)?$")
+
 
 def parse_amount(text):
     """Parse a ledger amount into a Decimal.
@@ -14,4 +19,25 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    if not s:
+        raise ValueError(f"empty amount: {text!r}")
+
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+
+    sign = ""
+    if s[:1] in "+-":
+        sign, s = s[0], s[1:]
+        if sign == "-":
+            negative = not negative
+
+    if not _NUMBER_RE.match(s):
+        raise ValueError(f"invalid amount: {text!r}")
+
+    value = Decimal(s.replace(",", ""))
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
