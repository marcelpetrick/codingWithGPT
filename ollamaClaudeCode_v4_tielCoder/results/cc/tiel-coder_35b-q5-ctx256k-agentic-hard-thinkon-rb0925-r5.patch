+def _single_currency(entries):
+    """Return the shared currency, or raise ValueError if currencies differ."""
+    currencies = {entry.currency for entry in entries}
+    if len(currencies) > 1:
+        raise ValueError("entries are not all in one currency")
+    return next(iter(currencies)) if currencies else None
 
 
