 """Money parsing."""
+import re
 from decimal import Decimal
 
+# A cleaned amount: integer digits with an optional fractional part.
+_NUMBER = re.compile(r"^\d+(\.\d+)?$")
+
 
 def parse_amount(text):
     """Parse a ledger amount into a Decimal.
@@ -14,4 +18,25 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    if not s:
+        raise ValueError(f"empty amount: {text!r}")
+
+    negative = False
+    if s[0] == "(" and s[-1] == ")":
+        negative = True
+        s = s[1:-1].strip()
+    if s.startswith("-"):
+        negative = True
+        s = s[1:]
+    elif s.startswith("+"):
+        s = s[1:]
+    s = s.strip().replace(",", "")
+
+    if not _NUMBER.match(s):
+        raise ValueError(f"invalid amount: {text!r}")
+
+    value = Decimal(s)
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
