diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..da15c4b 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,21 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    if not text:
+        raise ValueError("empty amount")
+
+    # Handle parentheses for negative amounts
+    if text.startswith("(") and text.endswith(")"):
+        text = "-" + text[1:-1]
+
+    # Remove thousands separators (commas)
+    text = text.replace(",", "")
+
+    try:
+        result = Decimal(text)
+    except Exception:
+        raise ValueError(f"invalid amount: {text!r}")
+
+    # Ensure exactly two decimal places
+    return result.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..c24c5d4 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,7 +26,28 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
+    # Strip whitespace
+    stripped = line.strip()
+    # Skip blank lines
+    if not stripped:
+        return None
+    # Skip comments
+    if stripped[0] == "#":
+        return None
+
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"malformed line: {line!r}")
+
+    day, category, amount, currency = parts
+    day = day.strip()
+    category = category.strip().lower()
+    amount = amount.strip()
+    currency = currency.strip().upper()
+
+    if len(currency) != 3:
+        raise ValueError(f"currency must be 3 letters: {currency!r}")
+
     return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
 
 
