 #include "backlogsummary.h"
+#include "issuemodel.h"
+#include <QAbstractItemModel>
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    connect(m_model, &QAbstractItemModel::rowsInserted, this, &BacklogSummary::recompute);
+    connect(m_model, &QAbstractItemModel::rowsRemoved, this, &BacklogSummary::recompute);
+    connect(m_model, &QAbstractItemModel::modelReset, this, &BacklogSummary::recompute);
+    connect(m_model, &QAbstractItemModel::dataChanged, this, &BacklogSummary::recompute);
+    connect(m_model, &QObject::destroyed, this, [this]() { m_model = nullptr; });
+    // Establish the initial total without emitting: nothing has changed yet.
+    m_total = computeTotal();
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_model ? m_total : 0;
+}
+
+int BacklogSummary::computeTotal() const
+{
+    if (!m_model)
+        return 0;
+    int total = 0;
+    for (int row = 0; row < m_model->rowCount(); ++row) {
+        const QModelIndex index = m_model->index(row, 0);
+        if (!m_model->data(index, IssueModel::ClosedRole).toBool())
+            total += m_model->data(index, IssueModel::EstimateRole).toInt();
+    }
+    return total;
+}
+
+void BacklogSummary::recompute()
+{
+    const int total = computeTotal();
+    if (total != m_total) {
+        m_total = total;
+        emit totalChanged(total);
+    }
 }
