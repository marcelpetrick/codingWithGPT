@@ -1,8 +1,64 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
+#include <QMetaObject>
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+class BacklogSummaryPrivate
+{
+public:
+    IssueModel *model = nullptr;
+    int minutes = 0;
+
+    void recalculate(IssueModel *m)
+    {
+        minutes = 0;
+        if (!m)
+            return;
+        for (int i = 0; i < m->rowCount(); ++i) {
+            const QModelIndex idx = m->index(i, 0);
+            const bool closed = m->data(idx, IssueModel::ClosedRole).toBool();
+            const int estimate = m->data(idx, IssueModel::EstimateRole).toInt();
+            if (!closed)
+                minutes += estimate;
+        }
+    }
+};
+
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), d(new BacklogSummaryPrivate())
+{
+    d->model = model;
+    d->recalculate(model);
+
+    if (model) {
+        connect(model, &QAbstractItemModel::rowsInserted, this, [this](const QModelIndex &, int, int) {
+            d->recalculate(d->model);
+        });
+        connect(model, &QAbstractItemModel::rowsRemoved, this, [this](const QModelIndex &, int, int) {
+            d->recalculate(d->model);
+        });
+        connect(model, &QAbstractItemModel::modelReset, this, [this]() {
+            d->recalculate(d->model);
+        });
+        connect(model, &QAbstractItemModel::dataChanged, this, [this](const QModelIndex &, const QModelIndex &, const QVector<int> &roles) {
+            if (roles.contains(IssueModel::EstimateRole) || roles.contains(IssueModel::ClosedRole))
+                d->recalculate(d->model);
+        });
+        connect(model, &QObject::destroyed, this, [this]() {
+            d->model = nullptr;
+            if (d->minutes != 0) {
+                d->minutes = 0;
+                emit totalChanged(0);
+            }
+        });
+    }
+}
+
+BacklogSummary::~BacklogSummary()
+{
+    delete d;
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return d->minutes;
 }
