 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,19 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    if not text:
+        raise ValueError("Empty amount")
+
+    # Handle accounting negatives
+    if text.startswith("(") and text.endswith(")"):
+        text = "-" + text[1:-1]
+
+    # Handle thousands separators
+    text = text.replace(",", "")
+
+    try:
+        amount = Decimal(text)
+        return amount.quantize(Decimal("0.00"))
+    except (InvalidOperation, ValueError) as e:
+        raise ValueError(f"Invalid amount format: {text}") from e
