-        const QChar unit = part.back();
-        if (unit == 'd')
-            total += value * 24 * 60;
+        if (part.isEmpty())
+            return -1;
+        QChar unit = part.back();
+        QString numPart = part.left(part.size() - 1);
+        if (numPart.isEmpty())
+            return -1;
+        bool ok = false;
+        int value = numPart.toInt(&ok);
+        if (!ok || value < 0)
+            return -1;
+        if (unit == 'w')
+            total += value * 5 * 8 * 60;   // 1w = 5 days = 2400 minutes
+        else if (unit == 'd')
+            total += value * 8 * 60;      // 1d = 8 hours = 480 minutes
         else if (unit == 'h')
             total += value * 60;
         else if (unit == 'm')
             total += value;
+        else
+            return -1;                   // unknown unit
     }
     return total;
 }
 
 QString formatEstimate(int minutes)
 {
+    if (minutes < 0)
+        return "";
     QStringList out;
-    const int hours = minutes / 60;
-    if (hours)
-        out << QString::number(hours) + "h";
-    out << QString::number(minutes % 60) + "m";
+    int w = minutes / 2400;
+    minutes %= 2400;
+    int d = minutes / 480;
+    minutes %= 480;
+    int h = minutes / 60;
+    minutes %= 60;
+    int m = minutes;
+    if (w)
+        out << QString::number(w) + "w";
+    if (d)
+        out << QString::number(d) + "d";
+    if (h)
+        out << QString::number(h) + "h";
+    if (m || out.isEmpty())
+        out << QString::number(m) + "m";
     return out.join(' ');
 }
