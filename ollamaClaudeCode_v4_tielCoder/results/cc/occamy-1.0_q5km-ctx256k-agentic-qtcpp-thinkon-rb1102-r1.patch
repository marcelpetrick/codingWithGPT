@@ -1,8 +1,87 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model), m_modelDestroyed(false)
+{
+    if (m_model) {
+        connect(m_model, &QAbstractItemModel::rowsInserted, this, &BacklogSummary::onRowsInserted);
+        connect(m_model, &QAbstractItemModel::rowsAboutToBeRemoved, this, &BacklogSummary::onRowsAboutToBeRemoved);
+        connect(m_model, &QAbstractItemModel::modelReset, this, &BacklogSummary::onModelReset);
+        connect(m_model, &QAbstractItemModel::dataChanged, this, &BacklogSummary::onDataChanged);
+        connect(m_model, &QObject::destroyed, this, &BacklogSummary::onModelDestroyed);
+        recalc();
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    if (m_modelDestroyed)
+        return 0;
+    return m_sum;
+}
+
+void BacklogSummary::recalc()
+{
+    if (!m_model) {
+        m_sum = 0;
+        return;
+    }
+    int s = 0;
+    int rows = m_model->rowCount(QModelIndex());
+    for (int r = 0; r < rows; ++r) {
+        bool closed = m_model->data(m_model->index(r, 0), IssueModel::ClosedRole).toBool();
+        int est = m_model->data(m_model->index(r, 0), IssueModel::EstimateRole).toInt();
+        if (!closed)
+            s += est;
+    }
+    m_sum = s;
+}
+
+void BacklogSummary::onRowsInserted(const QModelIndex &, int first, int last)
+{
+    const int prev = m_sum;
+    for (int r = first; r <= last; ++r) {
+        bool closed = m_model->data(m_model->index(r, 0), IssueModel::ClosedRole).toBool();
+        int est = m_model->data(m_model->index(r, 0), IssueModel::EstimateRole).toInt();
+        if (!closed)
+            m_sum += est;
+    }
+    if (m_sum != prev)
+        emit totalChanged(m_sum);
+}
+
+void BacklogSummary::onRowsAboutToBeRemoved(const QModelIndex &, int first, int last)
+{
+    const int prev = m_sum;
+    for (int r = first; r <= last; ++r) {
+        bool closed = m_model->data(m_model->index(r, 0), IssueModel::ClosedRole).toBool();
+        int est = m_model->data(m_model->index(r, 0), IssueModel::EstimateRole).toInt();
+        if (!closed)
+            m_sum -= est;
+    }
+    if (m_sum != prev)
+        emit totalChanged(m_sum);
+}
+
+void BacklogSummary::onModelReset()
+{
+    const int prev = m_sum;
+    recalc();
+    if (m_sum != prev)
+        emit totalChanged(m_sum);
+}
+
+void BacklogSummary::onDataChanged(const QModelIndex &, const QModelIndex &, const QVector<int> &)
+{
+    const int prev = m_sum;
+    recalc();
+    if (m_sum != prev)
+        emit totalChanged(m_sum);
+}
+
+void BacklogSummary::onModelDestroyed()
+{
+    m_modelDestroyed = true;
+    m_model = nullptr;
 }
