 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,38 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    # Accounting negatives in parentheses: "(12.50)" means -12.50
+    if text.startswith("(") and text.endswith(")"):
+        inner = text[1:-1].strip()
+        negated = "(" in text  # always negative when wrapped in parens
+        result = _parse_plain(inner)
+        return -result if negated else result
+
+    return _parse_plain(text)
+
+
+def _parse_plain(text):
+    """Parse a plain amount string, handling thousands separators and zero-padding."""
+    text = text.strip()
+
+    # Thousands separators: "1,234.50" -> "1234.50"
+    if "," in text:
+        # Remove all thousands-group commas (commas between digits)
+        # e.g., "1,234.50" -> "1234.50", "12,345,678.90" -> "12345678.90"
+        import re
+        cleaned = re.sub(r'(?<=\d),(?=\d)', '', text)
+        # If after removing intra-digit commas there are still commas, it's invalid
+        if "," in cleaned:
+            raise ValueError(f"Invalid amount with commas: {text}")
+        text = cleaned
+
+    try:
+        result = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"Cannot parse amount: {text!r}")
+
+    # Always two decimal places
+    # Quantize to 2 decimal places; this also handles rounding
+    return result.quantize(Decimal("0.01"))
