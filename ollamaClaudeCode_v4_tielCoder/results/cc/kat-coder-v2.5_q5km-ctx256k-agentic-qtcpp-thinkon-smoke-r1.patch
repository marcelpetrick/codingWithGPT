 int parseEstimate(const QString &text)
 {
+    if (text.trimmed().isEmpty())
+        return -1;
     int total = 0;
-    const QStringList parts = text.split(' ');
+    const QStringList parts = text.split(' ', Qt::SkipEmptyParts);
     for (const QString &part : parts) {
+        if (part.size() < 2)
+            return -1;
         const int value = part.left(part.size() - 1).toInt();
+        if (value < 0)
+            return -1;
         const QChar unit = part.back();
-        if (unit == 'd')
-            total += value * 24 * 60;
+        if (unit == 'w')
+            total += value * 5 * 8 * 60;
+        else if (unit == 'd')
+            total += value * 8 * 60;
         else if (unit == 'h')
             total += value * 60;
         else if (unit == 'm')
             total += value;
+        else
+            return -1;
     }
     return total;
 }
 
 QString formatEstimate(int minutes)
 {
+    if (minutes < 0)
+        return QString();
     QStringList out;
+    const int weeks = minutes / (5 * 8 * 60);
+    if (weeks)
+        out << QString::number(weeks) + "w";
+    minutes %= 5 * 8 * 60;
+    const int days = minutes / (8 * 60);
+    if (days)
+        out << QString::number(days) + "d";
+    minutes %= 8 * 60;
     const int hours = minutes / 60;
     if (hours)
         out << QString::number(hours) + "h";
-    out << QString::number(minutes % 60) + "m";
+    minutes %= 60;
+    if (minutes || out.isEmpty())
+        out << QString::number(minutes) + "m";
     return out.join(' ');
 }
