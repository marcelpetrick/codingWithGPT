-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    if (m_model) {
+        connect(m_model, &QAbstractItemModel::rowsInserted,
+                this, &BacklogSummary::onRowsInserted);
+        connect(m_model, &QAbstractItemModel::rowsRemoved,
+                this, &BacklogSummary::onRowsRemoved);
+        connect(m_model, &QAbstractItemModel::modelReset,
+                this, &BacklogSummary::onModelReset);
+        connect(m_model, &QAbstractItemModel::dataChanged,
+                this, &BacklogSummary::onDataChanged);
+        for (int i = 0; i < m_model->rowCount(); ++i) {
+            const auto &issue = m_model->index(i, 0).data(IssueModel::EstimateRole).toInt();
+            const bool closed = m_model->index(i, 0).data(IssueModel::ClosedRole).toBool();
+            if (!closed)
+                m_openMinutes += issue;
+        }
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
+}
+
+void BacklogSummary::onRowsInserted(const QModelIndex &parent, int first, int last)
+{
+    Q_UNUSED(parent)
+    for (int i = first; i <= last; ++i) {
+        const auto idx = m_model->index(i, 0);
+        const int estimate = idx.data(IssueModel::EstimateRole).toInt();
+        const bool closed = idx.data(IssueModel::ClosedRole).toBool();
+        if (!closed)
+            m_openMinutes += estimate;
+    }
+    emit totalChanged(m_openMinutes);
+}
+
+void BacklogSummary::onRowsRemoved(const QModelIndex &parent, int first, int last)
+{
+    Q_UNUSED(parent)
+    for (int i = first; i <= last; ++i) {
+        // Rows have already been removed, so we use the original first offset
+        // to index into what was the original range. Since the model no longer
+        // contains these rows, we compute based on the old positions.
+        // Actually, after removal the model is shorter. We need to use the
+        // first index which still points to the removed row before removal.
+        // But the signal fires after removal. We use first as the starting
+        // row number - these rows are gone now, so we need to track differently.
+        // The standard approach: store the pre-removal data or recompute.
+        // Simpler: recompute from model.
+    }
+    // Recompute to be safe and simple
+    m_openMinutes = 0;
+    for (int i = 0; i < m_model->rowCount(); ++i) {
+        const auto idx = m_model->index(i, 0);
+        const int estimate = idx.data(IssueModel::EstimateRole).toInt();
+        const bool closed = idx.data(IssueModel::ClosedRole).toBool();
+        if (!closed)
+            m_openMinutes += estimate;
+    }
+    emit totalChanged(m_openMinutes);
+}
+
+void BacklogSummary::onModelReset()
+{
+    m_openMinutes = 0;
+    for (int i = 0; i < m_model->rowCount(); ++i) {
+        const auto idx = m_model->index(i, 0);
+        const int estimate = idx.data(IssueModel::EstimateRole).toInt();
+        const bool closed = idx.data(IssueModel::ClosedRole).toBool();
+        if (!closed)
+            m_openMinutes += estimate;
+    }
+    emit totalChanged(m_openMinutes);
+}
+
+void BacklogSummary::onDataChanged(const QModelIndex &topLeft, const QModelIndex &bottomRight,
+                                    const QVector<int> &roles)
+{
+    Q_UNUSED(bottomRight)
+    if (roles.contains(IssueModel::EstimateRole) || roles.contains(IssueModel::ClosedRole)) {
+        for (int row = topLeft.row(); row <= bottomRight.row(); ++row) {
+            const auto idx = m_model->index(row, 0);
+            const int estimate = idx.data(IssueModel::EstimateRole).toInt();
+            const bool closed = idx.data(IssueModel::ClosedRole).toBool();
+            if (closed)
+                m_openMinutes -= estimate; // was previously counted
+            else
+                m_openMinutes += estimate; // now counted
+        }
+        emit totalChanged(m_openMinutes);
+    }
 }
