diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..62924bc 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,16 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+    text = text.replace(",", "")
+    try:
+        value = Decimal(text)
+    except Exception as exc:
+        raise ValueError(f"cannot parse amount: {text!r}") from exc
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.00"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..837575b 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,16 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}")
+    day, category, amount, currency = (part.strip() for part in parts)
+    if len(currency) != 3:
+        raise ValueError(f"currency must be 3 letters, got {currency!r}")
+    return Entry(date.fromisoformat(day), category.lower(), parse_amount(amount), currency.upper())
 
 
