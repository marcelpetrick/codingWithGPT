diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..7219124 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -1,5 +1,5 @@
 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,16 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+    text = text.replace(",", "")
+    try:
+        result = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"Invalid amount: {text!r}")
+    if negative:
+        result = -result
+    return result.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..df71463 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,7 +26,17 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
+    stripped = line.strip()
+    if stripped == "" or stripped.startswith("#"):
+        return None
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"Expected 4 fields, got {len(parts)}")
+    day, category, amount, currency = (p.strip() for p in parts)
+    category = category.lower()
+    currency = currency.upper()
+    if len(currency) != 3:
+        raise ValueError(f"Currency must be 3 letters, got {currency!r}")
     return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
 
 
