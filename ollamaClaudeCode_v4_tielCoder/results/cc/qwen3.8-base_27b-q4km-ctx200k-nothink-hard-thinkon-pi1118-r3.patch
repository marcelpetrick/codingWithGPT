 def parse_amount(text):
     """Parse a ledger amount into a Decimal.
@@ -14,4 +16,24 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    if not isinstance(text, str):
+        raise ValueError(f"amount must be a string, got {type(text).__name__}")
+    body = text.strip()
+    negative = False
+    if body.startswith("(") and body.endswith(")"):
+        negative = True
+        body = body[1:-1].strip()
+    if negative and (body.startswith("-") or body.startswith("+")):
+        raise ValueError(f"invalid amount: {text!r}")
+    try:
+        value = Decimal(body.replace(",", ""))
+    except Exception as exc:
+        raise ValueError(f"invalid amount: {text!r}") from exc
+    if negative:
+        value = -value
+    if not value.is_finite():
+        raise ValueError(f"invalid amount: {text!r}")
+    try:
+        return value.quantize(TWO_PLACES)
+    except Exception as exc:
+        raise ValueError(f"invalid amount: {text!r}") from exc
