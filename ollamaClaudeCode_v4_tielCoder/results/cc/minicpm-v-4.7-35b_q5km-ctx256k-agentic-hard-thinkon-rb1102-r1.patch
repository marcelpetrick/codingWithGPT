 def category_breakdown(entries, month):
@@ -23,4 +25,25 @@ def category_breakdown(entries, month):
     Categories whose total is exactly zero are left out. Entries from other
     months are ignored. Same single-currency rule as monthly_totals.
     """
-    raise NotImplementedError
+    # Filter entries for the given month
+    month_entries = [e for e in entries if f"{e.day.year}-{e.day.month:02d}" == month]
+
+    if not month_entries:
+        return []
+
+    # Check single currency
+    currencies = {e.currency for e in month_entries}
+    if len(currencies) != 1:
+        raise ValueError("entries must share one currency")
+
+    # Sum per category
+    cats = {}
+    for e in month_entries:
+        cats[e.category] = cats.get(e.category, 0) + e.amount
+
+    # Filter out zero totals and sort by total ascending (largest expense first),
+    # then by category name for ties
+    result = [(cat, total) for cat, total in cats.items() if total != 0]
+    result.sort(key=lambda x: (x[1], x[0]))
+
+    return result
