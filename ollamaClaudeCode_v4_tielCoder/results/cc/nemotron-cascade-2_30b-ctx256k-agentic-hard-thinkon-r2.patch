+"""Parse ledger text into entries.""" 
+from dataclasses import dataclass
+from datetime import date
+from decimal import Decimal
+
+from ledger.money import parse_amount
+
+@dataclass(frozen=True) 
+class Entry:
+    day: date
+    category: str
+    amount: Decimal
+    currency: str
+
+def parse_line(line): 
+    """Parse one line of the form DATE;CATEGORY;AMOUNT;CURRENCY 
+
+    * DATE is ISO 8601, YYYY-MM-DD 
+    * CATEGORY is stripped and lower‑cased 
+    * AMOUNT is parsed with parse_amount 
+    * CURRENCY is stripped, upper‑cased, and must be exactly three letters 
+    * any field may be surrounded by whitespace 
+
+    Blank lines, and lines whose first non‑space character is  ' #', return None. 
+    Anything malformed raises ValueError. 
+    """ 
+    stripped  = line.strip() 
+    if not stripped or stripped.startswith('#'): 
+        return None 
+
+    parts  =  [p.strip() for p in stripped.split(';')] 
+    if len(parts)  != 4: 
+        raise ValueError(f"Expected 4 fields, got {len(parts)}") 
+
+    day_str, category, amount_str, currency = parts 
+
+    try: 
+        entry_date = date.fromisoformat(day_str) 
+    except Exception as e: 
+        raise ValueError(f"Invalid date: {day_str}") from e 
+
+    entry_category = category.lower() 
+    entry_amount  = parse_amount(amount_str) 
+    entry_currency = currency.upper() 
+
+    return Entry( entry_date, entry_category, entry_amount, entry_currency ) 
+
+def parse_ledger(text): 
+    entries  =  (parse_line(line) for line in text.splitlines()) 
+    return  [e for e in entries if e is not None] 
