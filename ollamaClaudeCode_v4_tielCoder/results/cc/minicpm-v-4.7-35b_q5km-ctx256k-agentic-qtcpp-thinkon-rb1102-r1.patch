@@ -1,8 +1,81 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model), m_openMinutes(0)
+{
+    if (m_model) {
+        connect(m_model, &IssueModel::modelReset, this, &BacklogSummary::onModelReset);
+        connect(m_model, &IssueModel::rowsInserted, this, &BacklogSummary::onRowsInserted);
+        connect(m_model, &IssueModel::rowsRemoved, this, &BacklogSummary::onRowsRemoved);
+        connect(m_model, &IssueModel::dataChanged, this, &BacklogSummary::onDataChanged);
+        recalculate();
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
+}
+
+void BacklogSummary::onModelReset()
+{
+    recalculate();
+}
+
+void BacklogSummary::onRowsInserted(const QModelIndex &parent, int first, int last)
+{
+    Q_UNUSED(parent)
+    for (int row = first; row <= last; ++row) {
+        QModelIndex index = m_model->index(row, 0);
+        bool closed = m_model->data(index, IssueModel::ClosedRole).toBool();
+        int estimate = m_model->data(index, IssueModel::EstimateRole).toInt();
+        if (!closed)
+            m_openMinutes += estimate;
+    }
+    emit totalChanged(m_openMinutes);
+}
+
+void BacklogSummary::onRowsRemoved(const QModelIndex &parent, int first, int last)
+{
+    Q_UNUSED(parent)
+    for (int row = first; row <= last; ++row) {
+        QModelIndex index = m_model->index(row, 0);
+        bool closed = m_model->data(index, IssueModel::ClosedRole).toBool();
+        int estimate = m_model->data(index, IssueModel::EstimateRole).toInt();
+        if (!closed)
+            m_openMinutes -= estimate;
+    }
+    emit totalChanged(m_openMinutes);
+}
+
+void BacklogSummary::onDataChanged(const QModelIndex &topLeft, const QModelIndex &bottomRight)
+{
+    int oldOpen = m_openMinutes;
+    // Recalculate the entire sum to be safe
+    m_openMinutes = 0;
+    for (int row = 0; row < m_model->rowCount(); ++row) {
+        QModelIndex index = m_model->index(row, 0);
+        bool closed = m_model->data(index, IssueModel::ClosedRole).toBool();
+        int estimate = m_model->data(index, IssueModel::EstimateRole).toInt();
+        if (!closed)
+            m_openMinutes += estimate;
+    }
+    if (oldOpen != m_openMinutes)
+        emit totalChanged(m_openMinutes);
+}
+
+void BacklogSummary::recalculate()
+{
+    m_openMinutes = 0;
+    if (!m_model)
+        return;
+    for (int row = 0; row < m_model->rowCount(); ++row) {
+        QModelIndex index = m_model->index(row, 0);
+        bool closed = m_model->data(index, IssueModel::ClosedRole).toBool();
+        int estimate = m_model->data(index, IssueModel::EstimateRole).toInt();
+        if (!closed)
+            m_openMinutes += estimate;
+    }
+    emit totalChanged(m_openMinutes);
 }
