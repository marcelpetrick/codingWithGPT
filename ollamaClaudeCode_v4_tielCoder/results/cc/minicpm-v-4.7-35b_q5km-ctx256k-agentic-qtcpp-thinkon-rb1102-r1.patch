+        if (unit == 'w')
+            total += value * 5 * 8 * 60;  // 5 days * 8 hours * 60 minutes
+        else if (unit == 'd')
+            total += value * 8 * 60;      // 8 hours * 60 minutes
         else if (unit == 'h')
             total += value * 60;
         else if (unit == 'm')
             total += value;
+        else
+            return -1;  // unknown unit
     }
     return total;
 }
 
 QString formatEstimate(int minutes)
 {
+    if (minutes < 0)
+        return "";
