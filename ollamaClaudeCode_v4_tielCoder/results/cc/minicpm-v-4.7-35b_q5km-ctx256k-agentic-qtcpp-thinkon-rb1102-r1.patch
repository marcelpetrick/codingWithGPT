+
+    const int weeks = minutes / minutesPerWeek;
+    if (weeks) {
+        out << QString::number(weeks) + "w";
+        minutes %= minutesPerWeek;
+    }
+    const int days = minutes / minutesPerDay;
+    if (days) {
+        out << QString::number(days) + "d";
