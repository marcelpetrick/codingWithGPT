 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,19 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    # Handle accounting negative format: (12.50) means -12.50
+    if text.startswith('(') and text.endswith(')'):
+        text = '-' + text[1:-1]
+
+    # Handle thousands separators by removing commas
+    text = text.replace(',', '')
+
+    try:
+        result = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"Invalid amount: {text}")
+
+    # Always return exactly two decimal places
+    return result.quantize(Decimal('0.01'))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..0ad1b43 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,25 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    # Handle blank lines
+    if not line.strip():
+        return None
+
+    # Handle comment lines
+    if line.strip().startswith('#'):
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"Expected 4 fields, got {len(parts)}")
+
+    day, category, amount, currency = parts
+    return Entry(
+        date.fromisoformat(day.strip()),
+        category.strip().lower(),
+        parse_amount(amount.strip()),
+        currency.strip().upper()
+    )
 
 
