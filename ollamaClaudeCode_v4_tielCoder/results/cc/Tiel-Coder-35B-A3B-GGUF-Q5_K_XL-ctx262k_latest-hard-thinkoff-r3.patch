 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
+
+CENTS = Decimal("0.01")
 
 
 def parse_amount(text):
@@ -14,4 +16,31 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    if not s:
+        raise ValueError("empty amount")
+
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+
+    sign = 1
+    if s.startswith("+"):
+        s = s[1:].strip()
+    elif s.startswith("-"):
+        s = s[1:].strip()
+        sign = -1
+
+    # Remove thousands separators, then parse.
+    cleaned = s.replace(",", "")
+    try:
+        magnitude = Decimal(cleaned)
+    except InvalidOperation as exc:
+        raise ValueError(f"invalid amount: {text!r}") from exc
+
+    magnitude = abs(magnitude).quantize(CENTS)
+    value = sign * magnitude
+    if negative:
+        value = -value
+    return value
