     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    if not isinstance(text, str):
+        raise ValueError("amount must be a string")
+
+    s = text.strip()
+
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        inner = s[1:-1].strip()
+        if inner.startswith(("+", "-")):
+            raise ValueError("a sign is not allowed inside parentheses")
+        negative = True
+        s = inner
+
+    # Thousands separators are not part of a Decimal literal.
+    s = s.replace(",", "")
+
+    try:
+        value = Decimal(s).quantize(_TWO_PLACES)
+    except InvalidOperation:
+        raise ValueError("invalid amount: %r" % (text,)) from None
+
+    if not value.is_finite():
+        raise ValueError("invalid amount: %r" % (text,))
+
+    return -value if negative else value
