+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+
+    fields = line.split(";")
+    if len(fields) != 4:
+        raise ValueError("expected four ';'-separated fields")
+
+    day_s, category_s, amount_s, currency_s = fields
+
+    day = date.fromisoformat(day_s.strip())
+    category = category_s.strip().lower()
+    amount = parse_amount(amount_s)
+    currency = currency_s.strip().upper()
+
+    if len(currency) != 3 or not currency.isalpha() or not currency.isascii():
+        raise ValueError("currency must be exactly three letters")
+
+    return Entry(day, category, amount, currency)
 
 
