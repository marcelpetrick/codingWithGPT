-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+namespace {
+int sumOpenMinutes(IssueModel *model)
+{
+    const int total = model->rowCount();
+    int sum = 0;
+    for (int row = 0; row < total; ++row) {
+        const QModelIndex idx = model->index(row, 0);
+        const bool closed = model->data(idx, IssueModel::ClosedRole).toBool();
+        if (!closed)
+            sum += model->data(idx, IssueModel::EstimateRole).toInt();
+    }
+    return sum;
+}
+}
+
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_total(0), m_alive(true)
+{
+    m_total = sumOpenMinutes(model);
+    auto update = [this, model]() {
+        const int sum = sumOpenMinutes(model);
+        if (sum != m_total) {
+            m_total = sum;
+            emit totalChanged(m_total);
+        }
+    };
+    connect(model, &QAbstractItemModel::rowsInserted, this, update);
+    connect(model, &QAbstractItemModel::rowsRemoved, this, update);
+    connect(model, &QAbstractItemModel::modelReset, this, update);
+    connect(model, &QAbstractItemModel::dataChanged, this, update);
+    connect(model, &QObject::destroyed, this, [this]() {
+        m_alive = false;
+        m_total = 0;
+    });
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_alive ? m_total : 0;
 }
