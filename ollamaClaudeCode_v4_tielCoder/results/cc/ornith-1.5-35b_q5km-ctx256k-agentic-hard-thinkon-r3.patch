-from decimal import Decimal
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
 
 
 def parse_amount(text):
@@ -14,4 +14,36 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    if not isinstance(text, str):
+        raise ValueError(f"amount must be a string, got {type(text).__name__}")
+
+    s = text.strip()
+
+    # Accounting negatives written in parentheses.
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+
+    # Strip an explicit sign.
+    if s.startswith("+"):
+        s = s[1:].strip()
+    elif s.startswith("-"):
+        negative = True
+        s = s[1:].strip()
+
+    # Remove thousands separators before parsing.
+    s = s.replace(",", "")
+
+    if not s:
+        raise ValueError(f"no amount in {text!r}")
+
+    try:
+        value = Decimal(s)
+    except InvalidOperation:
+        raise ValueError(f"invalid amount: {text!r}") from None
+
+    if negative:
+        value = -value
+
+    return value.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..969d0e3 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,28 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}: {line!r}")
+    day_s, category_s, amount_s, currency_s = parts
+
+    try:
+        day = date.fromisoformat(day_s.strip())
+    except ValueError as exc:
+        raise ValueError(f"invalid date: {day_s!r}") from exc
+
+    category = category_s.strip().lower()
+    amount = parse_amount(amount_s.strip())
+
+    currency = currency_s.strip().upper()
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"currency must be three letters: {currency!r}")
+
+    return Entry(day, category, amount, currency)
 
 
