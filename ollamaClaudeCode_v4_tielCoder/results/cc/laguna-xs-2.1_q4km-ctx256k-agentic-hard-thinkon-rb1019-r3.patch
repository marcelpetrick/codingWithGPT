diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..ec1bb0d 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,27 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    # Handle accounting negatives in parentheses: (12.50) means -12.50
+    negative = False
+    if text.startswith('(') and text.endswith(')'):
+        negative = True
+        text = text[1:-1]
+
+    # Remove thousands separators (commas)
+    text = text.replace(',', '')
+
+    try:
+        result = Decimal(text)
+    except Exception:
+        raise ValueError(f"Invalid amount: {text}")
+
+    # Apply negative sign if needed
+    if negative:
+        result = -result
+
+    # Ensure exactly two decimal places
+    result = result.quantize(Decimal('0.01'))
+
+    return result
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..ed935c1 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,7 +26,21 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
+    # Skip blank lines
+    stripped = line.strip()
+    if not stripped:
+        return None
+    # Skip comment lines (starting with #)
+    if stripped.startswith('#'):
+        return None
+
     day, category, amount, currency = line.split(";")
+    # Strip whitespace from each field
+    day = day.strip()
+    category = category.strip().lower()
+    amount = amount.strip()
+    currency = currency.strip().upper()
+
     return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
 
 
