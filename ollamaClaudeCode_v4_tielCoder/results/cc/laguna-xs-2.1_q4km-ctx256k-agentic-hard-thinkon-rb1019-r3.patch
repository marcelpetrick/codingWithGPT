 def category_breakdown(entries, month):
@@ -23,4 +25,20 @@ def category_breakdown(entries, month):
     Categories whose total is exactly zero are left out. Entries from other
     months are ignored. Same single-currency rule as monthly_totals.
     """
-    raise NotImplementedError
+    from decimal import Decimal
+
+    # Filter entries for the given month and aggregate by category
+    category_totals = {}
+    for entry in entries:
+        entry_month = f"{entry.day.year}-{entry.day.month:02d}"
+        if entry_month == month:
+            if entry.category not in category_totals:
+                category_totals[entry.category] = Decimal("0")
+            category_totals[entry.category] += entry.amount
+
+    # Filter out zero totals and sort by total ascending (largest expense first),
+    # with ties broken by category name
+    filtered = [(cat, total) for cat, total in category_totals.items() if total != Decimal("0")]
+    filtered.sort(key=lambda x: (x[1], x[0]))
+
+    return filtered
