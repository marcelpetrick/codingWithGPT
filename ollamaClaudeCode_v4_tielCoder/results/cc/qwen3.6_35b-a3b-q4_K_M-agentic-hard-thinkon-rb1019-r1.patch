diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..278a47a 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,30 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+
+    # Handle accounting-style parentheses: (12.50) → -12.50
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1].strip()
+
+    # Strip leading sign
+    if text.startswith(("+", "-")):
+        if text.startswith("-"):
+            negative = not negative
+        text = text[1:].strip()
+
+    # Remove thousands separators
+    text = text.replace(",", "")
+
+    try:
+        result = Decimal(text)
+    except Exception as exc:
+        raise ValueError(f"cannot parse amount: {text!r}") from exc
+
+    if negative:
+        result = -result
+
+    # Normalize to exactly two decimal places
+    return result.quantize(Decimal("0.00"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..afc9aee 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,25 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if stripped == "" or stripped[0] == "#":
+        return None
+
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields separated by ';', got {len(parts)}")
+
+    day_str, category, amount_str, currency = parts
+    currency = currency.strip().upper()
+    if len(currency) != 3:
+        raise ValueError(f"currency must be exactly 3 letters, got {currency!r}")
+
+    return Entry(
+        date.fromisoformat(day_str.strip()),
+        category.strip().lower(),
+        parse_amount(amount_str),
+        currency,
+    )
 
 
