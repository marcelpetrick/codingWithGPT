@@ -14,4 +12,21 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    # Strip surrounding whitespace
+    text = text.strip()
+
+    # Handle accounting negatives in parentheses
+    if text.startswith("(") and text.endswith(")"):
+        text = "-" + text[1:-1]
+
+    # Remove thousands separators (commas)
+    text = text.replace(",", "")
+
+    try:
+        # Parse the amount
+        amount = Decimal(text)
+
+        # Always return exactly two decimal places
+        return amount.quantize(Decimal("0.00"))
+    except InvalidOperation:
+        raise ValueError(f"Invalid amount format: {text}")
