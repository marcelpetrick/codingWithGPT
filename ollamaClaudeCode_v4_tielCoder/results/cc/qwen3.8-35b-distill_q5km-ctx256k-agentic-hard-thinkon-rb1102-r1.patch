diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..494d7d9 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,16 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1].strip()
+    text = text.replace(",", "")
+    try:
+        result = Decimal(text)
+    except Exception:
+        raise ValueError(f"cannot parse amount: {text!r}")
+    if negative:
+        result = -result
+    return result.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
