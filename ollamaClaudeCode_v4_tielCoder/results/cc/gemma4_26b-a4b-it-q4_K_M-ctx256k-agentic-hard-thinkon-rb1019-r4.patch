+    line = line.strip()
+    if not line or line.startswith('#'):
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError("Expected 4 fields separated by ';'")
+
+    day_str, category_str, amount_str, currency_str = parts
+
+    day = date.fromisoformat(day_str.strip())
+    category = category_str.strip().lower()
+    amount = parse_amount(amount_str.strip())
+    currency = currency_str.strip().upper()
+
+    if len(currency) != 3:
+        raise ValueError("Currency must be exactly 3 letters")
+
+    return Entry(day, category, amount, currency)
 
 
