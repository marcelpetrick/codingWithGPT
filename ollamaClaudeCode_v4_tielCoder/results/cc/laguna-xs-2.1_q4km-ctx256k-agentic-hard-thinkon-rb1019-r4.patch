diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..3ed252a 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,28 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    # Handle accounting negatives in parentheses: (12.50) means -12.50
+    negative = False
+    if text.startswith('(') and text.endswith(')'):
+        negative = True
+        text = text[1:-1]
+
+    # Remove thousands separators (commas)
+    text = text.replace(',', '')
+
+    # Parse the decimal
+    try:
+        result = Decimal(text)
+    except Exception as e:
+        raise ValueError(f"Invalid amount: {text}") from e
+
+    # Apply negative sign if needed
+    if negative:
+        result = -result
+
+    # Ensure exactly two decimal places
+    result = result.quantize(Decimal('0.01'))
+
+    return result
