 """Money parsing."""
+import re
 from decimal import Decimal
 
+# A plain or signed decimal, optionally with thousands separators, e.g.
+# "7", "+12.50", "-1,234.50". Surrounding whitespace is handled by the caller.
+_AMOUNT_RE = re.compile(r"^[+-]?(\d{1,3}(?:,\d{3})*|\d+)(?:\.(\d+))?$")
+
 
 def parse_amount(text):
     """Parse a ledger amount into a Decimal.
@@ -14,4 +19,25 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    if not isinstance(text, str):
+        raise ValueError(f"amount must be a string, not {type(text).__name__}")
+
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1].strip()
+
+    match = _AMOUNT_RE.match(text)
+    if not match:
+        raise ValueError(f"unrecognised amount: {text!r}")
+
+    digits = match.group(1).replace(",", "")
+    if match.group(2) is not None:
+        digits += "." + match.group(2)
+    sign = "-" if text.startswith("-") else "+"
+
+    value = Decimal(sign + digits)
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
