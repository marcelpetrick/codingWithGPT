@@ -1,5 +1,5 @@
 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,30 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    if not text:
+        raise ValueError(f"Cannot parse empty amount")
+
+    # Handle accounting negatives in parentheses: "(12.50)" means -12.50
+    if text.startswith("(") and text.endswith(")"):
+        inner = text[1:-1].strip()
+        negative = True
+    else:
+        inner = text
+        negative = False
+
+    # Remove thousands separators (commas)
+    inner = inner.replace(",", "")
+
+    try:
+        value = Decimal(inner)
+    except InvalidOperation:
+        raise ValueError(f"Cannot parse amount: {text!r}")
+
+    # Ensure exactly two decimal places
+    value = value.quantize(Decimal("0.01"))
+
+    if negative:
+        value = -value
+
+    return value
