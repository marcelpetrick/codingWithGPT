@@ -14,4 +14,23 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    if s.startswith("+"):
+        s = s[1:].strip()
+    elif s.startswith("-"):
+        negative = True
+        s = s[1:].strip()
+    s = s.replace(",", "")
+    try:
+        value = Decimal(s)
+    except InvalidOperation:
+        raise ValueError(f"not a valid amount: {text!r}")
+    if not value.is_finite():
+        raise ValueError(f"not a valid amount: {text!r}")
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..f1c881b 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,25 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped[0] == "#":
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected DATE;CATEGORY;AMOUNT;CURRENCY, got {line!r}")
+
+    day, category, amount, currency = (field.strip() for field in parts)
+
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"currency must be three letters, got {currency!r}")
+
+    try:
+        parsed_day = date.fromisoformat(day)
+    except ValueError:
+        raise ValueError(f"invalid date, got {day!r}")
+
+    return Entry(parsed_day, category.lower(), parse_amount(amount), currency.upper())
 
 
