+"""Parse ledger text into entries."""
+from dataclasses import dataclass
+from datetime import date
+from decimal import Decimal
+
+from .money import parse_Amount
+
+@dataclass(frozen=True)
+class Entry:
+    day: date
+    category: str
+    amount: Decimal
+    currency: str
+
+def parse_ledger(text):
+    entries = (parse_ledger_line(line) for line in text.splitlines())
+    return [e for e in entries if e is not None]
+
+def parse_ledger_line(line):
+    stripped = line.strip()
+    # Remove possible UTF-8 BOM
+    if stripped.startswith("﻿"):
+        stripped = stripped[1:].strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+    parts = [p.strip() for p in line.split(";")]
+    if len(parts) != 4:
+        raise ValueError(f"Expected 4 fields, got {len(parts)}")
+    day_str, category, amount_str, currency = parts
+    try:
+        entry_date = date.fromisoformat(day_str)
+    except Exception as e:
+        raise ValueError(f"Invalid date: {day_str}") from e
+    entry_category = category.lower()
+    entry_amount = parse_Amount(amount_str)
+    entry_currency = currency.upper()
+    return Entry(entry_date, entry_category, entry_amount, entry_currency)
+
+def parse_line(line):
+    stripped = line.strip()
+    # Remove possible UTF-8 BOM
+    if stripped.startswith("﻿"):
+        stripped = stripped[1:].strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+    parts = [p.strip() for p in line.split(";")]
+    if len(parts) != 4:
+        raise ValueError(f"Expected 4 fields, got {len(parts)}")
+    day_str, category, amount_str, currency = parts
+    try:
+        entry_date = date.fromisoformat(day_str)
+    except Exception as e:
+        raise ValueError(f"Invalid date: {day_str}") from e
+    entry_category = category.lower()
+    entry_amount = parse_Amount(amount_str)
+    entry_currency = currency.upper()
+    return Entry(entry_date, entry_category, entry_amount, entry_currency)
+
+parse_Line = parse_ledger_line
