+        return {};
+
     QStringList out;
-    const int hours = minutes / 60;
+    const int weeks = minutes / (5 * 8 * 60);
+    if (weeks)
+        out << QString::number(weeks) + "w";
+
+    const int afterWeeks = minutes % (5 * 8 * 60);
+    const int days = afterWeeks / (8 * 60);
+    if (days)
+        out << QString::number(days) + "d";
+
+    const int afterDays = afterWeeks % (8 * 60);
