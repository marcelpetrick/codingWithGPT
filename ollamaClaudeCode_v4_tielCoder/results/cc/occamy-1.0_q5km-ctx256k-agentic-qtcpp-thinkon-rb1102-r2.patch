@@ -1,8 +1,57 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model), m_total(0)
+{
+    if (m_model) {
+        recompute();
+
+        connect(m_model, &QAbstractItemModel::rowsInserted,
+                this, &BacklogSummary::recompute);
+        connect(m_model, &QAbstractItemModel::rowsRemoved,
+                this, &BacklogSummary::recompute);
+        connect(m_model, &QAbstractItemModel::layoutChanged,
+                this, &BacklogSummary::recompute);
+        connect(m_model, &QAbstractItemModel::dataChanged,
+                this, &BacklogSummary::recompute);
+
+        connect(m_model, &QObject::destroyed, this, [this]() {
+            m_model = nullptr;
+            if (m_total != 0) {
+                m_total = 0;
+                emit totalChanged(0);
+            }
+        });
+    }
+}
+
+BacklogSummary::~BacklogSummary() = default;
+
+void BacklogSummary::recompute()
+{
+    if (!m_model)
+        return;
+
+    int total = 0;
+    const int rows = m_model->rowCount();
+    for (int i = 0; i < rows; ++i) {
+        const QModelIndex idx = m_model->index(i, 0);
+        const bool closed = idx.data(IssueModel::ClosedRole).toBool();
+        const int estimate = idx.data(IssueModel::EstimateRole).toInt();
+        if (!closed)
+            total += estimate;
+    }
+
+    if (total != m_total) {
+        m_total = total;
+        emit totalChanged(m_total);
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    if (!m_model)
+        return 0;
+    return m_total;
 }
