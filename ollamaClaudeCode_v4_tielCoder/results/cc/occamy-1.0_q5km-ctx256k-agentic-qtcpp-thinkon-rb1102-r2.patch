+        bool ok = false;
+        const int value = numStr.toInt(&ok);
+        if (!ok || value < 0)
+            return -1; // missing number or negative number
+
+        switch (unit.toLatin1()) {
+        case 'w': total += value * 5 * 8 * 60; break; // 5 days of 8 hours
+        case 'd': total += value * 8 * 60; break;     // 8 hours
