 #include "backlogsummary.h"
+#include "issuemodel.h"
+#include <QMetaObject>
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    if (model) {
+        connect(model, &QAbstractItemModel::rowsInserted,
+                this, &BacklogSummary::onRowsInserted);
+        connect(model, &QAbstractItemModel::rowsRemoved,
+                this, &BacklogSummary::onRowsRemoved);
+        connect(model, &QAbstractItemModel::modelReset,
+                this, &BacklogSummary::onModelReset);
+        connect(model, &QAbstractItemModel::dataChanged,
+                this, &BacklogSummary::onDataChanged);
+        connect(model, &QObject::destroyed,
+                this, &BacklogSummary::onModelDestroyed);
+        m_total = compute();
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_model ? compute() : 0;
+}
+
+int BacklogSummary::compute() const
+{
+    int total = 0;
+    for (int row = 0; row < m_model->rowCount(); ++row) {
+        const QModelIndex index = m_model->index(row, 0);
+        if (!m_model->data(index, IssueModel::ClosedRole).toBool())
+            total += m_model->data(index, IssueModel::EstimateRole).toInt();
+    }
+    return total;
+}
+
+void BacklogSummary::onRowsInserted(const QModelIndex &, int, int)
+{
+    const int total = compute();
+    if (total != m_total) {
+        m_total = total;
+        emit totalChanged(total);
+    }
+}
+
+void BacklogSummary::onRowsRemoved(const QModelIndex &, int, int)
+{
+    const int total = compute();
+    if (total != m_total) {
+        m_total = total;
+        emit totalChanged(total);
+    }
+}
+
+void BacklogSummary::onModelReset()
+{
+    const int total = compute();
+    if (total != m_total) {
+        m_total = total;
+        emit totalChanged(total);
+    }
+}
+
+void BacklogSummary::onDataChanged(const QModelIndex &, const QModelIndex &, const QList<int> &roles)
+{
+    if (roles.isEmpty())
+        return;
+    const int total = compute();
+    if (total != m_total) {
+        m_total = total;
+        emit totalChanged(total);
+    }
+}
+
+void BacklogSummary::onModelDestroyed()
+{
+    m_model = nullptr;
+    if (m_total != 0) {
+        m_total = 0;
+        emit totalChanged(0);
+    }
 }
