+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -7,11 +7,25 @@ def parse_amount(text):
 
     Accepted forms, surrounding whitespace ignored:
 
-    * plain or signed decimals: "12.50", "-12.50", "+12.50", "7"
+    * plain or signed decimals: "12.50", "-12:50", "+12.50", "7"
     * thousands separators: "1,234.50"
     * accounting negatives in parentheses: "(12.50)" means -12.50
 
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    if not text:
+        raise ValueError("empty amount")
+
+    if text.startswith("(") and text.endswith(")"):
+        text = "-" + text[1:-1]
+
+    text = text.replace(",", "")
+
+    try:
+        amount = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"Invalid amount: {text}")
+
+    return amount.quantize(Decimal("0.00"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..5d08833 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,29 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped_line = line.strip()
+    if not stripped_line or stripped_line.startswith("#"):
+        return None
+
+    parts = [p.strip() for p in stripped_line.split(";")]
+    if len(parts) != 4:
+        raise ValueError(f"Expected 4 fields, got {len(parts)}")
+
+    day_str, category, amount_str, currency = parts
+
+    try:
+        day = date.fromisoformat(day_str)
+    except ValueError:
+        raise ValueError(f"Invalid date: {day_str}")
+
+    category = category.lower()
+    amount = parse_amount(amount_str)
+    currency = currency.upper()
+
+    if len(currency) != 3:
+        raise ValueError(f"Currency must be 3 letters, got {currency}")
+
+    return Entry(day, category, amount, currency)
 
 
