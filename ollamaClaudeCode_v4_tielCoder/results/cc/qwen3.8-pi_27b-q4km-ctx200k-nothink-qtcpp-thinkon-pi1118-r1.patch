index 257e0df..efc980d 100644
--- a/src/backlogsummary.cpp
+++ b/src/backlogsummary.cpp
@@ -1,8 +1,51 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    if (model) {
+        connect(model, &QAbstractItemModel::rowsInserted, this, &BacklogSummary::recalculate);
+        connect(model, &QAbstractItemModel::rowsRemoved, this, &BacklogSummary::recalculate);
+        connect(model, &QAbstractItemModel::modelReset, this, &BacklogSummary::recalculate);
+        connect(model, &QAbstractItemModel::dataChanged, this, [this](const QModelIndex &, const QModelIndex &, const QVector<int> &roles) {
+            if (roles.isEmpty()
+                || roles.contains(IssueModel::EstimateRole)
+                || roles.contains(IssueModel::ClosedRole))
+                recalculate();
+        });
+        connect(model, &QObject::destroyed, this, &BacklogSummary::onModelDestroyed);
+        recalculate();
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
+}
+
+void BacklogSummary::recalculate()
+{
+    if (!m_model)
+        return;
+    int total = 0;
+    const int count = m_model->rowCount();
+    for (int row = 0; row < count; ++row) {
+        const QModelIndex index = m_model->index(row, 0);
+        if (!m_model->data(index, IssueModel::ClosedRole).toBool())
+            total += m_model->data(index, IssueModel::EstimateRole).toInt();
+    }
+    if (total != m_openMinutes) {
+        m_openMinutes = total;
+        emit totalChanged(total);
+    }
+}
+
+void BacklogSummary::onModelDestroyed()
+{
+    m_model = nullptr;
+    if (m_openMinutes != 0) {
+        m_openMinutes = 0;
+        emit totalChanged(0);
+    }
 }
