--- a/ledger/money.py
+++ b/ledger/money.py
@@ -1,5 +1,22 @@
 """Money parsing."""
-from decimal import Decimal
+import re
+
+from decimal import Decimal, InvalidOperation
+
+# Matches a plain or signed decimal, with optional well-formed thousands
+# separators.  The integer part is either a plain run of digits (any length)
+# or a 1-3 digit leading group followed by groups of exactly three digits.
+#  No comma may appear in the fractional part.
+_AMOUNT_RE = re.compile(
+    r"^[+-]?"
+    r"(?:\d+|\d{1,3}(,\d{3})*)"   # integer part: plain or comma-separated
+    r"(\.\d+)?$"                   # optional fractional part
+)
+
+
+def _is_well_formed_amount(value):
+    """Return True if value is a well-formed (possibly comma-separated) decimal."""
+    return _AMOUNT_RE.match(value) is not None
 
 
 def parse_amount(text):
@@ -14,4 +31,19 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    if not isinstance(text, str):
+        raise ValueError(f"expected a string amount, got {text!r}")
+    value = text.strip()
+    negative = False
+    if value.startswith("(") and value.endswith(")"):
+        negative = True
+        value = value[1:-1].strip()
+    # Validate the comma structure before stripping commas, so that
+    # malformed separators like "1,,234" or "12,34" are rejected.
+    if not _is_well_formed_amount(value):
+        raise ValueError(f"invalid amount: {text!r}")
+    value = value.replace(",", "")
+    result = Decimal(value)
+    if negative:
+        result = -result
+    return result.quantize(Decimal("0.01"))
