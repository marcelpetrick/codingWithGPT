 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,28 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    negative = False
+
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    if s.startswith("-"):
+        negative = True
+        s = s[1:].strip()
+    elif s.startswith("+"):
+        s = s[1:].strip()
+
+    s = s.replace(",", "")
+    if s == "":
+        raise ValueError(f"empty amount: {text!r}")
+
+    try:
+        value = Decimal(s)
+    except InvalidOperation:
+        raise ValueError(f"invalid amount: {text!r}") from None
+
+    if negative:
+        value = -value
+
+    return value.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..43c84dc 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,25 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if stripped == "" or stripped.startswith("#"):
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}: {line!r}")
+
+    day, category, amount, currency = (p.strip() for p in parts)
+
+    if not currency.isalpha() or len(currency) != 3:
+        raise ValueError(f"currency must be exactly three letters: {currency!r}")
+
+    return Entry(
+        date.fromisoformat(day),
+        category.lower(),
+        parse_amount(amount),
+        currency.upper(),
+    )
 
 
