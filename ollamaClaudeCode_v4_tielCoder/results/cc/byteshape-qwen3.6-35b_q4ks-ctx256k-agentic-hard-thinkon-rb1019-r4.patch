 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, ROUND_HALF_UP
 
 
 def parse_amount(text):
@@ -14,4 +14,19 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    # Handle accounting negatives in parentheses
+    if text.startswith("(") and text.endswith(")"):
+        text = "-" + text[1:-1]
+
+    # Strip thousands separators (commas)
+    text = text.replace(",", "")
+
+    try:
+        result = Decimal(text)
+    except Exception:
+        raise ValueError(f"Invalid amount: {text!r}")
+
+    # Round to exactly two decimal places
+    return result.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
