 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, ROUND_HALF_UP
 
 
 def parse_amount(text):
@@ -14,4 +14,32 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    if not s:
+        raise ValueError("empty amount")
+
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+
+    # Remove thousands separators (commas)
+    s = s.replace(",", "")
+
+    if s.startswith("-"):
+        negative = not negative
+        s = s[1:]
+    elif s.startswith("+"):
+        s = s[1:]
+
+    try:
+        result = Decimal(s)
+    except Exception:
+        raise ValueError(f"cannot parse amount: {text!r}")
+
+    if negative:
+        result = -result
+
+    # Normalize to exactly two decimal places
+    result = result.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+    return result
