 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,16 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1].strip()
+    text = text.replace(",", "")
+    try:
+        result = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"cannot parse {text!r} as a number")
+    if negative:
+        result = -result
+    return result.quantize(Decimal("0.00"))
