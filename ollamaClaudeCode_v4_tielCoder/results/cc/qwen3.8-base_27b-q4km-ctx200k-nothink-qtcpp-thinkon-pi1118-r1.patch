-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    if (model) {
+        connect(model, &QObject::destroyed, this, &BacklogSummary::onModelDestroyed);
+        connect(model, &QAbstractItemModel::rowsInserted, this, &BacklogSummary::onModelChanged);
+        connect(model, &QAbstractItemModel::rowsRemoved, this, &BacklogSummary::onModelChanged);
+        connect(model, &QAbstractItemModel::modelReset, this, &BacklogSummary::onModelChanged);
+        connect(model, &QAbstractItemModel::dataChanged, this, &BacklogSummary::onModelChanged);
+    }
+    onModelChanged();
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
+}
+
+void BacklogSummary::onModelChanged()
+{
+    int total = 0;
+    if (m_model) {
+        const int rows = m_model->rowCount();
+        for (int row = 0; row < rows; ++row) {
+            const QModelIndex index = m_model->index(row);
+            if (m_model->data(index, IssueModel::ClosedRole).toBool())
+                continue;
+            total += m_model->data(index, IssueModel::EstimateRole).toInt();
+        }
+    }
+    if (total != m_openMinutes) {
+        m_openMinutes = total;
+        emit totalChanged(m_openMinutes);
+    }
+}
+
+void BacklogSummary::onModelDestroyed(QObject *object)
+{
+    if (object != m_model)
+        return;
+    m_model = nullptr;
+    onModelChanged();
 }
