@@ -1,8 +1,48 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model), m_openMinutes(0)
+{
+    if (m_model) {
+        // Connect to model signals
+        connect(m_model, &QAbstractItemModel::rowsInserted, this, &BacklogSummary::onModelChanged);
+        connect(m_model, &QAbstractItemModel::rowsRemoved, this, &BacklogSummary::onModelChanged);
+        connect(m_model, &QAbstractItemModel::modelReset, this, &BacklogSummary::onModelChanged);
+        connect(m_model, &QAbstractItemModel::dataChanged, this, &BacklogSummary::onModelChanged);
+        // Initial calculation
+        onModelChanged();
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
+}
+
+void BacklogSummary::onModelChanged()
+{
+    if (!m_model) {
+        if (m_openMinutes != 0) {
+            m_openMinutes = 0;
+            emit totalChanged(0);
+        }
+        return;
+    }
+
+    int total = 0;
+    const int rowCount = m_model->rowCount();
+    for (int row = 0; row < rowCount; ++row) {
+        const QModelIndex index = m_model->index(row, 0);
+        const bool closed = m_model->data(index, IssueModel::ClosedRole).toBool();
+        if (!closed) {
+            const int estimate = m_model->data(index, IssueModel::EstimateRole).toInt();
+            total += estimate;
+        }
+    }
+
+    if (total != m_openMinutes) {
+        m_openMinutes = total;
+        emit totalChanged(total);
+    }
 }
