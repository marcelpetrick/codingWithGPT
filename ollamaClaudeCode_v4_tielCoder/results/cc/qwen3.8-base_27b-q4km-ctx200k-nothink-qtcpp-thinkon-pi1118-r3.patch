@@ -1,8 +1,69 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    if (m_model) {
+        connect(m_model, &QAbstractItemModel::rowsInserted, this, &BacklogSummary::onRowsInserted);
+        connect(m_model, &QAbstractItemModel::rowsRemoved, this, &BacklogSummary::onRowsRemoved);
+        connect(m_model, &QAbstractItemModel::modelReset, this, &BacklogSummary::onModelReset);
+        connect(m_model, &QAbstractItemModel::dataChanged, this, [this](const QModelIndex &, const QModelIndex &, const QVector<int> &roles) {
+            if (roles.isEmpty() || roles.contains(IssueModel::EstimateRole) || roles.contains(IssueModel::ClosedRole))
+                recalculate();
+        });
+        connect(m_model, &QObject::destroyed, this, [this](QObject *) {
+            if (m_model) {
+                m_model = nullptr;
+                onModelDestroyed();
+            }
+        });
+        m_openMinutes = recalculate();
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
+}
+
+int BacklogSummary::recalculate()
+{
+    int total = 0;
+    if (m_model) {
+        for (int row = 0; row < m_model->rowCount(); ++row) {
+            const QModelIndex index = m_model->index(row, 0);
+            if (m_model->data(index, IssueModel::ClosedRole).toBool())
+                continue;
+            total += m_model->data(index, IssueModel::EstimateRole).toInt();
+        }
+    }
+    if (total != m_openMinutes) {
+        m_openMinutes = total;
+        emit totalChanged(total);
+    }
+    return m_openMinutes;
+}
+
+void BacklogSummary::onRowsInserted(const QModelIndex &, int, int)
+{
+    recalculate();
+}
+
+void BacklogSummary::onRowsRemoved(const QModelIndex &, int, int)
+{
+    recalculate();
+}
+
+void BacklogSummary::onModelReset()
+{
+    recalculate();
+}
+
+void BacklogSummary::onModelDestroyed()
+{
+    if (m_openMinutes != 0) {
+        m_openMinutes = 0;
+        emit totalChanged(0);
+    }
 }
