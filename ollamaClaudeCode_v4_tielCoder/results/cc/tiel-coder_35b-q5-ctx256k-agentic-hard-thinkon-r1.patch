 def parse_amount(text):
@@ -14,4 +14,18 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+    text = text.replace(",", "")
+    if text.startswith("+"):
+        text = text[1:]
+    try:
+        value = Decimal(text)
+    except InvalidOperation as exc:
+        raise ValueError(f"not a valid amount: {text!r}") from exc
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..82b4869 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,24 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}: {line!r}")
+
+    day, category, amount, currency = (field.strip() for field in parts)
+
+    entry_day = date.fromisoformat(day)
+    entry_category = category.lower()
+    entry_amount = parse_amount(amount)
+    entry_currency = currency.upper()
+    if len(entry_currency) != 3 or not entry_currency.isalpha():
+        raise ValueError(f"currency must be three letters: {currency!r}")
+
+    return Entry(entry_day, entry_category, entry_amount, entry_currency)
 
 
