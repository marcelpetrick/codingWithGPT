@@ -1,8 +1,68 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
+#include <QAbstractItemModel>
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    connect(m_model, &QAbstractItemModel::rowsInserted,
+            this, [this](const QModelIndex &parent, int first, int last) {
+        if (parent.isValid())
+            return;
+        for (int row = first; row <= last; ++row) {
+            const QModelIndex idx = m_model->index(row, 0);
+            if (!m_model->data(idx, IssueModel::ClosedRole).toBool())
+                m_openMinutes += m_model->data(idx, IssueModel::EstimateRole).toInt();
+        }
+        emit totalChanged(m_openMinutes);
+    });
+    connect(m_model, &QAbstractItemModel::rowsRemoved,
+            this, [this](const QModelIndex &parent, int first, int last) {
+        if (parent.isValid())
+            return;
+        for (int row = first; row <= last; ++row) {
+            const QModelIndex idx = m_model->index(row, 0);
+            if (!m_model->data(idx, IssueModel::ClosedRole).toBool())
+                m_openMinutes -= m_model->data(idx, IssueModel::EstimateRole).toInt();
+        }
+        emit totalChanged(m_openMinutes);
+    });
+    connect(m_model, &QAbstractItemModel::modelReset,
+            this, &BacklogSummary::recompute);
+    connect(m_model, &QAbstractItemModel::dataChanged,
+            this, [this](const QModelIndex &topLeft, const QModelIndex &bottomRight,
+                         const QVector<int> &roles) {
+        if (roles.contains(IssueModel::EstimateRole) || roles.contains(IssueModel::ClosedRole))
+            recompute();
+    });
+    // The model is destroyed before this summary: openMinutes() returns 0.
+    connect(m_model, &QObject::destroyed,
+            this, [this]() { m_openMinutes = 0; });
+    recompute();
+}
+
+void BacklogSummary::recompute()
+{
+    if (m_model == nullptr) {
+        if (m_openMinutes != 0) {
+            m_openMinutes = 0;
+            emit totalChanged(m_openMinutes);
+        }
+        return;
+    }
+    int total = 0;
+    for (int row = 0; row < m_model->rowCount(); ++row) {
+        const QModelIndex idx = m_model->index(row, 0);
+        if (!m_model->data(idx, IssueModel::ClosedRole).toBool())
+            total += m_model->data(idx, IssueModel::EstimateRole).toInt();
+    }
+    if (total != m_openMinutes) {
+        m_openMinutes = total;
+        emit totalChanged(m_openMinutes);
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
 }
