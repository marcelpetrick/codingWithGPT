diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..a4372c8 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,31 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+
+    # Handle accounting-style parentheses: (12.50) → -12.50
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1].strip()
+
+    # Remove thousands separators
+    text = text.replace(",", "")
+
+    # Strip leading sign
+    if text.startswith("+"):
+        text = text[1:]
+    elif text.startswith("-"):
+        negative = not negative
+        text = text[1:]
+
+    try:
+        result = Decimal(text)
+    except Exception:
+        raise ValueError(f"cannot parse amount: {text!r}")
+
+    if negative:
+        result = -result
+
+    # Normalize to exactly two decimal places
+    return result.quantize(Decimal("0.01"))
