 """Money parsing."""
+import re
 from decimal import Decimal
 
+# Sign, digits with optional thousands separators, optional decimal part.
+# A thousands-separated integer has groups of three digits after the first comma;
+# the decimal part (if any) is a plain run of digits (no commas).
+_AMOUNT = re.compile(r"^[+-]?(?:(\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?|\.\d+)$")
+
 
 def parse_amount(text):
     """Parse a ledger amount into a Decimal.
@@ -14,4 +20,20 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = str(text).strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        # Accounting-style negative.
+        negative = True
+        s = s[1:-1].strip()
+        # Only a decimal amount in parentheses is a documented form.
+        if "." not in s:
+            raise ValueError(f"invalid amount: {text!r}")
+
+    if not _AMOUNT.match(s):
+        raise ValueError(f"invalid amount: {text!r}")
+
+    value = Decimal(s.replace(",", ""))
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
