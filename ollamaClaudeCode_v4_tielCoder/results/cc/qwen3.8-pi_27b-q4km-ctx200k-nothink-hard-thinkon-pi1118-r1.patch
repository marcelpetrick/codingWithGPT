 """Money parsing."""
+import re
 from decimal import Decimal
 
 
@@ -14,4 +15,22 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    negative = False
+    if len(s) >= 2 and s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    if not s:
+        raise ValueError(f"invalid amount: {text!r}")
+    if "," in s:
+        # Commas only as thousands separators: groups of three between sign
+        # and decimal point.
+        if not re.fullmatch(r"[+-]?\d{1,3}(,\d{3})*(\.\d+)?", s):
+            raise ValueError(f"invalid amount: {text!r}")
+        s = s.replace(",", "")
+    elif not re.fullmatch(r"[+-]?\d+(\.\d+)?", s):
+        raise ValueError(f"invalid amount: {text!r}")
+    value = Decimal(s)
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
