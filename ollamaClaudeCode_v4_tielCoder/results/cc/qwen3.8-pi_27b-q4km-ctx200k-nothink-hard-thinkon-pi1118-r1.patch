+++ b/ledger/parser.py
@@ -26,8 +26,22 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+    fields = stripped.split(";")
+    if len(fields) != 4:
+        raise ValueError(f"expected 4 fields, got {len(fields)}: {line!r}")
+    day, category, amount, currency = fields
+    currency = currency.strip().upper()
+    if not currency.isalpha() or len(currency) != 3:
+        raise ValueError(f"currency must be exactly three letters: {currency!r}")
+    try:
+        day = date.fromisoformat(day.strip())
+    except ValueError:
+        raise ValueError(f"invalid date: {day!r}") from None
+    category = category.strip().lower()
+    return Entry(day, category, parse_amount(amount), currency)
 
 
