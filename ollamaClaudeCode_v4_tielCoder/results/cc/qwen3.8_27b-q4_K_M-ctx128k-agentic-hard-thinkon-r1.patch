@@ -26,8 +30,22 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"malformed line: {line!r}")
+    day_raw, category_raw, amount_raw, currency_raw = (part.strip() for part in parts)
+    if not _DATE_RE.match(day_raw):
+        raise ValueError(f"malformed date: {day_raw!r}")
+    day = date.fromisoformat(day_raw)
+    category = category_raw.lower()
+    amount = parse_amount(amount_raw)
+    currency = currency_raw.upper()
+    if not _CURRENCY_RE.match(currency):
+        raise ValueError(f"invalid currency: {currency!r}")
+    return Entry(day, category, amount, currency)
 
 
