 from decimal import Decimal
 
 from .money import parse_amount
 
+_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+_CURRENCY_RE = re.compile(r"^[A-Za-z]{3}$")
+
 
 @dataclass(frozen=True)
