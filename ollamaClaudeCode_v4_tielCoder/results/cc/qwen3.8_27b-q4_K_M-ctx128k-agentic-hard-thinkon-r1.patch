 """Money parsing."""
+import re
 from decimal import Decimal
 
+# Digits with optional thousands separators (strict comma groups) and an
+# optional decimal part, e.g. "7", "-12.50", "1,234.50".
+_AMOUNT_RE = re.compile(r"^[+-]?(\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?$")
+
 
 def parse_amount(text):
     """Parse a ledger amount into a Decimal.
@@ -14,4 +19,14 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    if not isinstance(text, str):
+        raise ValueError(f"invalid amount: {text!r}")
+    s = text.strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    if not _AMOUNT_RE.match(s):
+        raise ValueError(f"invalid amount: {text!r}")
+    value = Decimal(s.replace(",", "")).quantize(Decimal("0.01"))
+    return -value if negative else value
