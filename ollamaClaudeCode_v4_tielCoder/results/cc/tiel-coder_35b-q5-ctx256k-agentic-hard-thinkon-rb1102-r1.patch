 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
+
+TWO_PLACES = Decimal("0.01")
 
 
 def parse_amount(text):
@@ -14,4 +16,30 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    raw = text.strip()
+    if not raw:
+        raise ValueError("empty amount")
+
+    negative = False
+    if raw.startswith("(") and raw.endswith(")"):
+        negative = True
+        raw = raw[1:-1].strip()
+
+    if raw.startswith("+"):
+        raw = raw[1:]
+    elif raw.startswith("-"):
+        negative = not negative
+        raw = raw[1:]
+
+    if "," in raw:
+        raw = raw.replace(",", "")
+
+    try:
+        value = Decimal(raw)
+    except InvalidOperation:
+        raise ValueError(f"invalid amount: {text!r}")
+
+    value = value.quantize(TWO_PLACES)
+    if negative:
+        value = -value
+    return value
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..e912ea8 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,25 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped[0] == "#":
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}")
+
+    day, category, amount, currency = (field.strip() for field in parts)
+
+    if not currency.isalpha() or len(currency) != 3:
+        raise ValueError(f"currency must be three letters: {currency!r}")
+
+    return Entry(
+        date.fromisoformat(day),
+        category.lower(),
+        parse_amount(amount),
+        currency.upper(),
+    )
 
 
