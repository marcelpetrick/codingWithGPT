 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,25 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1].strip()
+    # Remove thousands separators (commas).
+    text = text.replace(",", "")
+    sign = 1
+    if text.startswith("+"):
+        text = text[1:].strip()
+    elif text.startswith("-"):
+        sign = -1
+        text = text[1:].strip()
+    try:
+        value = Decimal(text)
+    except InvalidOperation:  # noqa: BLE003 - we want to surface it as ValueError
+        raise ValueError(f"invalid amount: {text!r}")
+    value = value * sign
+    if negative:
+        value = -value
+    # Quantize to two decimal places.
+    return value.quantize(Decimal("0.01"), rounding="ROUND_HALF_UP")
