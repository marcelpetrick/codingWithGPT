 int parseEstimate(const QString &text)
 {
+    if (text.trimmed().isEmpty())
+        return -1;
+
     int total = 0;
     const QStringList parts = text.split(' ');
     for (const QString &part : parts) {
-        const int value = part.left(part.size() - 1).toInt();
-        const QChar unit = part.back();
-        if (unit == 'd')
-            total += value * 24 * 60;
+        const QString trimmed = part.trimmed();
+        if (trimmed.isEmpty())
+            continue;
+        if (trimmed.size() < 2)
+            return -1;
+        const QString numStr = trimmed.left(trimmed.size() - 1);
+        bool ok = false;
+        const int value = numStr.toInt(&ok);
+        if (!ok || value < 0)
+            return -1;
+        const QChar unit = trimmed.back();
+        if (unit == 'w')
+            total += value * 5 * 24 * 60;
+        else if (unit == 'd')
+            total += value * 8 * 60;
         else if (unit == 'h')
             total += value * 60;
         else if (unit == 'm')
             total += value;
+        else
+            return -1;
     }
     return total;
 }
 
 QString formatEstimate(int minutes)
 {
+    if (minutes < 0)
+        return {};
+
     QStringList out;
-    const int hours = minutes / 60;
+    const int weeks = minutes / (5 * 24 * 60);
+    if (weeks)
+        out << QString::number(weeks) + "w";
+    const int remaining = minutes - weeks * 5 * 24 * 60;
+    const int days = remaining / (8 * 60);
+    if (days)
+        out << QString::number(days) + "d";
+    const int remaining2 = remaining - days * 8 * 60;
+    const int hours = remaining2 / 60;
     if (hours)
         out << QString::number(hours) + "h";
-    out << QString::number(minutes % 60) + "m";
+    const int mins = remaining2 % 60;
+    out << QString::number(mins) + "m";
     return out.join(' ');
 }
