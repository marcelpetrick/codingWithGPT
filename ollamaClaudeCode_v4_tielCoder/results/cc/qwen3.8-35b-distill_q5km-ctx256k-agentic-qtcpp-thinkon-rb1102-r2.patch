@@ -1,8 +1,56 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
+#include <QModelIndex>
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent)
+    , m_model(model)
+{
+    if (model) {
+        connect(model, &IssueModel::rowsInserted, this, [this](const QModelIndex &, int start, int end) {
+            for (int i = start; i <= end; ++i) {
+                const QModelIndex idx = m_model->index(i, 0);
+                if (!idx.data(IssueModel::ClosedRole).toBool())
+                    m_total += idx.data(IssueModel::EstimateRole).toInt();
+            }
+            emit totalChanged(m_total);
+        });
+        connect(model, &IssueModel::rowsRemoved, this, [this](const QModelIndex &, int start, int end) {
+            for (int i = start; i <= end; ++i) {
+                const QModelIndex idx = m_model->index(i, 0);
+                if (!idx.data(IssueModel::ClosedRole).toBool())
+                    m_total -= idx.data(IssueModel::EstimateRole).toInt();
+            }
+            emit totalChanged(m_total);
+        });
+        connect(model, &IssueModel::dataChanged, this, [this](const QModelIndex &, const QModelIndex &, const QVector<int> &roles) {
+            for (int role : roles) {
+                if (role == IssueModel::EstimateRole || role == IssueModel::ClosedRole) {
+                    recalculate();
+                    emit totalChanged(m_total);
+                    return;
+                }
+            }
+        });
+        recalculate();
+        if (m_total > 0)
+            emit totalChanged(m_total);
+    }
+}
+
+void BacklogSummary::recalculate()
+{
+    m_total = 0;
+    if (!m_model)
+        return;
+    for (int i = 0; i < m_model->rowCount(); ++i) {
+        const QModelIndex idx = m_model->index(i, 0);
+        if (!idx.data(IssueModel::ClosedRole).toBool())
+            m_total += idx.data(IssueModel::EstimateRole).toInt();
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_total;
 }
