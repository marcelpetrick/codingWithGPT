diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..f54460b 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,27 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    if not text:
+        raise ValueError("empty amount")
+
+    # Accounting negative: (12.50)
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+
+    # Thousands separators: remove commas
+    text = text.replace(",", "")
+
+    # Parse the Decimal
+    try:
+        result = Decimal(text)
+    except Exception:
+        raise ValueError(f"cannot parse amount: {text!r}")
+
+    if negative:
+        result = -result
+
+    # Always two decimal places
+    return result.quantize(Decimal("0.01"))
