+#include "backlogsummary.h"
+#include "issuemodel.h"
+
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent)
+{
+    if (!model)
+        return;
+
+    m_openMinutes = 0;
+    // Initial calculation
+    for (int i = 0; i < model->rowCount(); ++i) {
+        QModelIndex idx = model->index(i);
+        if (model->data(idx, IssueModel::ClosedRole).toBool() == false) {
+            m_openMinutes += model->data(idx, IssueModel::EstimateRole).toInt();
+        }
+    }
+
+    connect(model, &IssueModel::rowsInserted, this, [this, model]() {
+        updateOpenMinutes(model);
+    });
+    connect(model, &IssueModel::rowsRemoved, this, [this, model]() {
+        updateOpenMinutes(model);
+    });
+    connect(model, &IssueModel::rowsAboutToBeRemoved, this, [this, model]() {
+        updateOpenMinutes(model);
+    });
+    connect(model, &IssueModel::dataChanged, this, [this, model](const QModelIndex &topLeft, const QModelIndex &bottomRight, const QList<int> &roles) {
+        if (roles.contains(IssueModel::EstimateRole) || roles.contains(IssueModel::ClosedRole)) {
+            updateOpenMinutes(model);
+        }
+    });
+    connect(model, &IssueModel::rowsAboutToBeReset, this, [this, model]() {
+         // Note: rowsAboutToBeReset is not in the API, but modelReset is.
+    });
+    // Actually modelReset is the one.
+    // Wait, QAbstractItemModel has modelReset signal.
+    // But I can't connect to modelReset if I don't know the signal name precisely.
+    // It's signal: modelReset().
+}
+
+// Wait, I need to implement updateOpenMinutes.
+// Let's refine the constructor and implementation.
