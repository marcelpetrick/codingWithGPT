 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
+}
+
+void BacklogSummary::updateOpenMinutes(IssueModel *model)
+{
+    int newMinutes = 0;
+    for (int i = 0; i < model->rowCount(); ++i) {
+        QModelIndex idx = model->index(i);
+        if (!model->data(idx, IssueModel::ClosedRole).toBool()) {
+            newMinutes += model->data(idx, IssueModel::EstimateRole).toInt();
+        }
+    }
+
+    if (newMinutes != m_openMinutes) {
+        m_openMinutes = newMinutes;
+        emit totalChanged(m_openMinutes);
+    }
 }
