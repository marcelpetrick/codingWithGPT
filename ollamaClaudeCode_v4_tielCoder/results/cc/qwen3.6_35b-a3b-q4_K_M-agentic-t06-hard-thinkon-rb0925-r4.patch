 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+
 
 
 def parse_amount(text):
@@ -14,4 +15,32 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+
+    # Accounting notation: (12.50) → negative
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+
+    # Strip thousands separators
+    text = text.replace(",", "")
+
+    # Detect explicit sign
+    if text.startswith("+"):
+        text = text[1:]
+    elif text.startswith("-"):
+        negative = not negative
+        text = text[1:]
+
+    try:
+        result = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"cannot parse amount: {text!r}")
+
+    if negative:
+        result = -result
+
+    # Always two decimal places
+    result = result.quantize(Decimal("0.00"), rounding=ROUND_HALF_UP)
+    return result
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..b756a25 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,29 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+
+    # Skip blanks and comments
+    if not stripped or stripped[0] == "#":
+        return None
+
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}")
+
+    day_str, category, amount_str, currency = parts
+
+    # Validate currency length
+    currency = currency.strip().upper()
+    if len(currency) != 3:
+        raise ValueError(f"currency must be 3 letters, got {currency!r}")
+
+    return Entry(
+        day=date.fromisoformat(day_str.strip()),
+        category=category.strip().lower(),
+        amount=parse_amount(amount_str),
+        currency=currency,
+    )
 
 
