 """Money parsing."""
+import decimal
 from decimal import Decimal
 
 
@@ -14,4 +15,17 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1].strip()
+    text = text.replace(",", "")
+    try:
+        result = Decimal(text)
+    except decimal.InvalidOperation:
+        raise ValueError(f"Cannot parse amount: {text!r}")
+    if negative:
+        result = -result
+    # Ensure exactly two decimal places
+    return result.quantize(Decimal("0.00"))
