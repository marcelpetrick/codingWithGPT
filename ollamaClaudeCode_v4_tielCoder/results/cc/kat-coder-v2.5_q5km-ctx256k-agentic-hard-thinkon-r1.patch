+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +15,24 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+
+    # Accounting notation: parentheses indicate negative
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+
+    # Remove thousands separators
+    text = text.replace(",", "")
+
+    try:
+        value = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"cannot parse amount: {text!r}")
+
+    if negative:
+        value = -value
+
+    # Quantize to exactly two decimal places
+    return value.quantize(Decimal("0.01"))
