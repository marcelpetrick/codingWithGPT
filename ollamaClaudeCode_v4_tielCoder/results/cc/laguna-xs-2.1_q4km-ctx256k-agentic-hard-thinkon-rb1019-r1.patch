@@ -23,4 +23,22 @@ def category_breakdown(entries, month):
     Categories whose total is exactly zero are left out. Entries from other
     months are ignored. Same single-currency rule as monthly_totals.
     """
-    raise NotImplementedError
+    from collections import defaultdict
+    from decimal import Decimal
+
+    # Aggregate totals per category for the given month
+    category_totals = defaultdict(lambda: Decimal('0'))
+
+    for entry in entries:
+        entry_month = f"{entry.day.year}-{entry.day.month:02d}"
