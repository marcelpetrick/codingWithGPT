 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,21 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    # Handle accounting negatives in parentheses: (12.50) means -12.50
+    if text.startswith('(') and text.endswith(')'):
+        text = '-' + text[1:-1]
+
+    # Remove thousands separators (commas)
+    text = text.replace(',', '')
+
+    try:
+        result = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"Invalid amount: {text!r}")
+
+    # Ensure exactly two decimal places
+    result = result.quantize(Decimal('0.01'))
+
+    return result
