+            category_totals[entry.category] += entry.amount
+
+    # Filter out zero totals, sort by total ascending (largest expense first),
+    # then by category name for ties
+    result = [
+        (cat, total) for cat, total in category_totals.items() if total != Decimal('0')
+    ]
