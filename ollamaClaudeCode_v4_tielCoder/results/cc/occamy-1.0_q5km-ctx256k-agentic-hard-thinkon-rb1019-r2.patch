 """Money parsing."""
+import decimal
 from decimal import Decimal
 
 
@@ -14,4 +15,16 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    s = s.replace(",", "")
+    try:
+        value = Decimal(s)
+    except decimal.InvalidOperation:
+        raise ValueError(f"invalid amount: {text!r}")
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..8164c98 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,20 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    s = line.strip()
+    if s == "" or s.startswith("#"):
+        return None
+    parts = s.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"invalid entry: {line!r}")
+    day, category, amount, currency = (p.strip() for p in parts)
+    entry_day = date.fromisoformat(day)
+    category = category.lower()
+    amount = parse_amount(amount)
+    currency = currency.upper()
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"invalid currency: {currency!r}")
+    return Entry(entry_day, category, amount, currency)
 
 
