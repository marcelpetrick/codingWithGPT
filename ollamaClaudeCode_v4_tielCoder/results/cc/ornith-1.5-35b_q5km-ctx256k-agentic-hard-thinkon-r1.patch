 """Money parsing."""
-from decimal import Decimal
+import re
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+
+# An unsigned magnitude: digits with optional groups of three separated by
+# commas, and an optional fractional part. The sign and parentheses are
+# handled separately below.
+_MAGNITUDE_RE = re.compile(r"[0-9]+(,[0-9]{3})*(.[0-9]+)?")
 
 
 def parse_amount(text):
@@ -14,4 +20,37 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    if not isinstance(text, str):
+        raise ValueError(f"amount must be text, got {type(text).__name__!r}")
+
+    s = text.strip()
+    if not s:
+        raise ValueError("empty amount")
+
+    negative = False
+
+    # Accounting negatives are wrapped in parentheses.
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1]
+
+    # An explicit leading sign flips the sign (double negation possible).
+    if s[:1] in "+-":
+        if s[0] == "-":
+            negative = not negative
+        s = s[1:]
+
+    # Validate the magnitude and drop thousands separators.
+    if not _MAGNITUDE_RE.fullmatch(s):
+        raise ValueError(f"invalid amount: {text!r}")
+    s = s.replace(",", "")
+
+    try:
+        value = Decimal(s)
+    except InvalidOperation as exc:
+        raise ValueError(f"invalid amount: {text!r}") from exc
+
+    if negative:
+        value = -value
+
+    return value.quantize(Decimal("0.00"), rounding=ROUND_HALF_UP)
