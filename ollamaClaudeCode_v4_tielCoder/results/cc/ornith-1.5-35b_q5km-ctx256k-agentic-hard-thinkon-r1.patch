+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}: {line!r}")
+
+    day_text, category_text, amount_text, currency_text = (part.strip() for part in parts)
+
+    day = date.fromisoformat(day_text)
+
+    category = category_text.lower()
+
+    amount = parse_amount(amount_text)
+
+    currency = currency_text.upper()
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"currency must be three letters: {currency!r}")
+
+    return Entry(day, category, amount, currency)
 
 
