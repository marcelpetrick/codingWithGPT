 """Money parsing."""
 from decimal import Decimal
+from decimal import InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +15,16 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    s = text.strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    s = s.replace(",", "")
+    try:
+        value = Decimal(s)
+    except (InvalidOperation, ValueError):
+        raise ValueError(f"invalid amount: {text!r}")
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..aefeb69 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,26 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    s = line.strip()
+    if not s or s.startswith("#"):
+        return None
+    parts = s.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"malformed line: {line!r}")
+    day, category, amount, currency = (
+        parts[0].strip(),
+        parts[1].strip().lower(),
+        parts[2].strip(),
+        parts[3].strip().upper(),
+    )
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"invalid currency: {currency!r}")
+    return Entry(
+        date.fromisoformat(day),
+        category,
+        parse_amount(amount),
+        currency,
+    )
 
 
