 def parse_line(line):
     """Parse one line of the form  DATE;CATEGORY;AMOUNT;CURRENCY
@@ -26,8 +29,25 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped[0] == "#":
+        return None
+
+    fields = line.split(";")
+    if len(fields) != 4:
+        raise ValueError(f"expected 4 fields, got {len(fields)}: {line!r}")
+
+    day, category, amount, currency = (field.strip() for field in fields)
+
+    if not _CURRENCY.fullmatch(currency):
+        raise ValueError(f"invalid currency: {currency!r}")
+
+    return Entry(
+        date.fromisoformat(day),
+        category.lower(),
+        parse_amount(amount),
+        currency.upper(),
+    )
 
 
