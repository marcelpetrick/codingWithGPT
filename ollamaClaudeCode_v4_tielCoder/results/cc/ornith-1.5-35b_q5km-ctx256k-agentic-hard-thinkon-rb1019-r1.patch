 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
 
 
 def parse_amount(text):
@@ -14,4 +14,25 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1].strip()
+    if text.startswith("+"):
+        text = text[1:].strip()
+    elif text.startswith("-"):
+        negative = True
+        text = text[1:].strip()
+    text = text.replace(",", "")
+    if not text:
+        raise ValueError(f"not a valid amount: {text!r}")
+    try:
+        value = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"not a valid amount: {text!r}")
+    if not value.is_finite():
+        raise ValueError(f"not a valid amount: {text!r}")
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..f940438 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,22 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+    fields = line.split(";")
+    if len(fields) != 4:
+        raise ValueError(
+            f"expected DATE;CATEGORY;AMOUNT;CURRENCY, got {line!r}"
+        )
+    day, category, amount, currency = (field.strip() for field in fields)
+    entry_day = date.fromisoformat(day)
+    category = category.lower()
+    entry_amount = parse_amount(amount)
+    currency = currency.upper()
+    if not (len(currency) == 3 and currency.isalpha()):
+        raise ValueError(f"invalid currency {currency!r}")
+    return Entry(entry_day, category, entry_amount, currency)
 
 
