 def parse_amount(text):
@@ -14,4 +14,24 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    cleaned = text.strip()
+    negative = False
+    if cleaned.startswith("(") and cleaned.endswith(")"):
+        negative = True
+        cleaned = cleaned[1:-1]
+    if cleaned.startswith("-"):
+        negative = True
+        cleaned = cleaned[1:]
+    elif cleaned.startswith("+"):
+        cleaned = cleaned[1:]
+
+    cleaned = cleaned.replace(",", "")
+    if not cleaned or not all(c in "0123456789." for c in cleaned):
+        raise ValueError(f"invalid amount: {text!r}")
+    if cleaned.count(".") > 1:
+        raise ValueError(f"invalid amount: {text!r}")
+
+    value = Decimal(cleaned)
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..d640365 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,26 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}: {line!r}")
+    day, category, amount, currency = (p.strip() for p in parts)
+
+    category = category.lower()
+    currency = currency.upper()
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"invalid currency: {currency!r}")
+
+    return Entry(
+        date.fromisoformat(day),
+        category,
+        parse_amount(amount),
+        currency,
+    )
 
 
