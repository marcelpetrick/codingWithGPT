diff --git a/ledger/money.py b/ledger/money.py
index 64dc61c..3ed5e1a 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -14,4 +14,16 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+    text = text.replace(",", "")
+    try:
+        value = Decimal(text)
+    except Exception:
+        raise ValueError(f"cannot parse amount: {text!r}")
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..1a3acc9 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,22 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped:
+        return None
+    if stripped.startswith("#"):
+        return None
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}")
+    day_s, category, amount_s, currency = parts
+    day = date.fromisoformat(day_s)
+    category = category.strip().lower()
+    amount = parse_amount(amount_s)
+    currency = currency.strip().upper()
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"currency must be 3 letters, got {currency!r}")
+    return Entry(day, category, amount, currency)
 
 
