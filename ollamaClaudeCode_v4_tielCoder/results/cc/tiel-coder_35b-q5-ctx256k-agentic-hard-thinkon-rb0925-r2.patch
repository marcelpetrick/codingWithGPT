+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
 
 
 def parse_amount(text):
@@ -14,4 +14,16 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    cleaned = text.strip()
+    negative = False
+    if cleaned.startswith("(") and cleaned.endswith(")"):
+        negative = True
+        cleaned = cleaned[1:-1].strip()
+    cleaned = cleaned.replace(",", "")
+    try:
+        value = Decimal(cleaned)
+    except InvalidOperation as exc:
+        raise ValueError(f"invalid amount: {text!r}") from exc
+    if negative:
+        value = -value
+    return value.quantize(Decimal("0.00"), rounding=ROUND_HALF_UP)
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..b5237fd 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,28 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if stripped == "" or stripped[0] == "#":
+        return None
+
+    parts = line.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected DATE;CATEGORY;AMOUNT;CURRENCY, got {line!r}")
+
+    day_s, category_s, amount_s, currency_s = (p.strip() for p in parts)
+
+    if not category_s:
+        raise ValueError(f"empty category in {line!r}")
+
+    if not (currency_s.isalpha() and len(currency_s) == 3):
+        raise ValueError(f"currency must be three letters, got {currency_s!r}")
+
+    return Entry(
+        date.fromisoformat(day_s),
+        category_s.lower(),
+        parse_amount(amount_s),
+        currency_s.upper(),
+    )
 
 
