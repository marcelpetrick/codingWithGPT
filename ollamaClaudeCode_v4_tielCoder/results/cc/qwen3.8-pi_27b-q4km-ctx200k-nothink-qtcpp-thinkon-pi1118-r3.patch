--- a/src/backlogsummary.cpp
+++ b/src/backlogsummary.cpp
@@ -1,8 +1,47 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    if (m_model) {
+        connect(m_model, &QAbstractItemModel::rowsInserted, this, [this](const QModelIndex &, int, int) { recalculate(); });
+        connect(m_model, &QAbstractItemModel::rowsRemoved, this, [this](const QModelIndex &, int, int) { recalculate(); });
+        connect(m_model, &QAbstractItemModel::modelReset, this, [this] { recalculate(); });
+        connect(m_model, &QAbstractItemModel::dataChanged, this, [this](const QModelIndex &first, const QModelIndex &last, const QVector<int> &roles) {
+            if (roles.isEmpty() || roles.contains(IssueModel::EstimateRole) || roles.contains(IssueModel::ClosedRole))
+                recalculate();
+        });
+        connect(m_model, &QObject::destroyed, this, [this] {
+            m_model = nullptr;
+            if (m_openMinutes != 0) {
+                m_openMinutes = 0;
+                emit totalChanged(m_openMinutes);
+            }
+        });
+    }
+    recalculate();
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
+}
+
+void BacklogSummary::recalculate()
+{
+    int total = 0;
+    if (m_model) {
+        const int rows = m_model->rowCount();
+        for (int row = 0; row < rows; ++row) {
+            const QModelIndex index = m_model->index(row);
+            if (m_model->data(index, IssueModel::ClosedRole).toBool())
+                continue;
+            total += m_model->data(index, IssueModel::EstimateRole).toInt();
+        }
+    }
+    if (total != m_openMinutes) {
+        m_openMinutes = total;
+        emit totalChanged(m_openMinutes);
+    }
 }
