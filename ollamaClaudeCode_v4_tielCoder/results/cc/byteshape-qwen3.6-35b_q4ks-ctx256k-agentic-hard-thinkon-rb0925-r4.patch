 """Money parsing."""
-from decimal import Decimal
+from decimal import Decimal, InvalidOperation
 
 
 def parse_amount(text):
@@ -14,4 +14,19 @@ def parse_amount(text):
     The result always carries exactly two decimal places, so "7" parses to
     Decimal("7.00"). Anything else raises ValueError.
     """
-    return Decimal(text)
+    text = text.strip()
+
+    # Parentheses = negative (accounting notation)
+    if text.startswith("(") and text.endswith(")"):
+        text = "-" + text[1:-1]
+
+    # Strip thousands separators (commas)
+    text = text.replace(",", "")
+
+    try:
+        value = Decimal(text)
+    except InvalidOperation:
+        raise ValueError(f"invalid amount: {text!r}")
+
+    # Always quantize to exactly two decimal places
+    return value.quantize(Decimal("0.01"))
diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..cc37893 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,22 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    stripped = line.strip()
+    if not stripped or stripped[0] == "#":
+        return None
+
+    parts = stripped.split(";")
+    if len(parts) != 4:
+        raise ValueError(f"expected 4 fields, got {len(parts)}")
+
+    day = date.fromisoformat(parts[0].strip())
+    category = parts[1].strip().lower()
+    amount = parse_amount(parts[2])
+    currency = parts[3].strip().upper()
+    if len(currency) != 3 or not currency.isalpha():
+        raise ValueError(f"currency must be exactly 3 letters: {currency!r}")
+
+    return Entry(day, category, amount, currency)
 
 
