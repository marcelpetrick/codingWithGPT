@@ -1,8 +1,48 @@
 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent), m_model(model)
+{
+    if (model) {
+        connect(model, &IssueModel::rowsInserted, this, &BacklogSummary::recalculate);
+        connect(model, &IssueModel::rowsRemoved, this, &BacklogSummary::recalculate);
+        connect(model, &IssueModel::modelReset, this, &BacklogSummary::recalculate);
+        connect(model, &IssueModel::dataChanged, this, &BacklogSummary::recalculate);
+        recalculate();
+    }
+}
+
+BacklogSummary::~BacklogSummary()
+{
+    m_model = nullptr;
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return m_openMinutes;
+}
+
+void BacklogSummary::recalculate()
+{
+    if (!m_model) {
+        if (m_openMinutes != 0) {
+            m_openMinutes = 0;
+            emit totalChanged(0);
+        }
+        return;
+    }
+    int total = 0;
+    const int count = m_model->rowCount();
+    for (int i = 0; i < count; ++i) {
+        const auto idx = m_model->index(i, 0);
+        const bool closed = m_model->data(idx, IssueModel::ClosedRole).toBool();
+        if (!closed) {
+            total += m_model->data(idx, IssueModel::EstimateRole).toInt();
+        }
+    }
+    if (total != m_openMinutes) {
+        m_openMinutes = total;
+        emit totalChanged(total);
+    }
 }
