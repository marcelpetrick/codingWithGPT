diff --git a/ledger/parser.py b/ledger/parser.py
index 52dd009..70000b3 100644
--- a/ledger/parser.py
+++ b/ledger/parser.py
@@ -26,8 +26,25 @@ def parse_line(line):
     Blank lines, and lines whose first non-space character is '#', return None.
     Anything malformed raises ValueError.
     """
-    day, category, amount, currency = line.split(";")
-    return Entry(date.fromisoformat(day), category, parse_amount(amount), currency)
+    line = line.strip()
+    if not line or line.startswith("#"):
+        return None
+
+    parts = [p.strip() for p in line.split(";")]
+    if len(parts) != 4:
+        raise ValueError("Expected 4 fields in line")
+
+    day, category, amount_str, currency = parts
+
+    if len(currency) != 3:
+        raise ValueError("Currency must be exactly 3 letters")
+
+    return Entry(
+        day=date.fromisoformat(day),
+        category=category.lower(),
+        amount=parse_amount(amount_str),
+        currency=currency.upper()
+    )
 
 
