 #include "backlogsummary.h"
+#include "issuemodel.h"
 
-BacklogSummary::BacklogSummary(IssueModel *, QObject *parent) : QObject(parent) {}
+#include <QDebug>
+
+class BacklogSummaryPrivate
+{
+public:
+    IssueModel *model = nullptr;
+    int total = 0;
+    void compute();
+};
+
+void BacklogSummaryPrivate::compute()
+{
+    int t = 0;
+    if (model) {
+        const int rows = model->rowCount();
+        for (int i = 0; i < rows; ++i) {
+            const QModelIndex idx = model->index(i);
+            const bool closed = model->data(idx, IssueModel::ClosedRole).toBool();
+            const int estimate = model->data(idx, IssueModel::EstimateRole).toInt();
+            if (!closed)
+                t += estimate;
+        }
+    }
+    total = t;
+}
+
+BacklogSummary::BacklogSummary(IssueModel *model, QObject *parent)
+    : QObject(parent)
+    , d(new BacklogSummaryPrivate())
+{
+    d->model = model;
+    d->compute();
+    if (model) {
+        connect(model, &QAbstractItemModel::rowsInserted,
+                this, [this](const QModelIndex &, int, int) { d->compute(); });
+        connect(model, &QAbstractItemModel::rowsRemoved,
+                this, [this](const QModelIndex &, int, int) { d->compute(); });
+        connect(model, &QAbstractItemModel::modelReset,
+                this, [this]() { d->compute(); });
+        connect(model, &QAbstractItemModel::dataChanged,
+                this, [this](const QModelIndex &topLeft, const QModelIndex &bottomRight,
+                             const QVector<int> &roles) {
+                    Q_UNUSED(topLeft);
+                    Q_UNUSED(bottomRight);
+                    Q_UNUSED(roles);
+                    d->compute();
+                });
+        connect(model, &QObject::destroyed,
+                this, [this]() { d->model = nullptr; d->total = 0; });
+    }
+}
 
 int BacklogSummary::openMinutes() const
 {
-    return -1;
+    return d->total;
 }
