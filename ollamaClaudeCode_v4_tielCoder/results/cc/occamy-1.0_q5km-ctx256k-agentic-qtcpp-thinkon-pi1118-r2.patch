+
+    if (total >= weekMinutes) {
+        out << QString::number(total / weekMinutes) + "w";
+        total %= weekMinutes;
+    }
+    if (total >= dayMinutes) {
+        out << QString::number(total / dayMinutes) + "d";
+        total %= dayMinutes;
+    }
+    if (total >= hourMinutes) {
+        out << QString::number(total / hourMinutes) + "h";
