[Unit]
Description=Observe Codex and Claude Code quota waits in KDE Konsole
Documentation=https://github.com/marcelpetrick/codingWithGPT/tree/master/AgentWhileTrue
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# The shipped service is deliberately read-only. Opting into terminal input
# requires an explicit user override from --observe to --auto.
ExecStart=%h/.local/bin/agent-watch run --observe --all --no-fzf
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
