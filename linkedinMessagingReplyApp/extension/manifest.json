{
  "manifest_version": 3,
  "name": "LinkedIn Reply Assistant Bridge",
  "short_name": "LRA Bridge",
  "version": "0.3.0",
  "description": "Inserts a draft approved in the LinkedIn Reply Assistant desktop app into the LinkedIn composer. Never sends.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["https://www.linkedin.com/messaging/*"],
  "background": { "service_worker": "background/service_worker.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/messaging/*"],
      "js": ["content/selectors.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": { "gecko": { "id": "lra@marcelpetrick.it" } }
}
